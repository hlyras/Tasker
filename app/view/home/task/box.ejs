<%- include('./create.ejs') %>

<script>
  let task_box = null;
  let task_status_select = null;
  let taskPopupRefresh = null;

  async function taskPopup() {
    const popup = lib.element.create("div", {
      class: "box b1 container task-popup padding-10"
    });

    const title_box = lib.element.create("div", {
      class: "mobile-box container center margin-bottom-10"
    });
    popup.append(title_box);

    title_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem09 padding-5 v-center"
    }, "Tarefas"));

    title_box.append(lib.element.create("img", {
      class: "image-prop size-25",
      src: "/images/icon/task.png"
    }));

    const create_button = lib.element.create("button", {
      type: "button",
      class: "box b1 btn-act lucida-grande bold noborder padding-8 margin-bottom-10 pointer noselect"
    }, "Nova tarefa");
    popup.append(create_button);

    create_button.addEventListener("click", async () => {
      lib.popup(await taskCreateForm(), false, true);
    });

    task_status_select = lib.element.create("select", {
      class: "box b1 lucida-grande bold rem09 padding-10 margin-bottom-10"
    });
    popup.append(task_status_select);

    task_status_select.append(lib.element.create("option", {
      value: "Pendente"
    }, "Pendente"));

    task_status_select.append(lib.element.create("option", {
      value: "Concluído"
    }, "Concluído"));

    task_box = lib.element.create("div", {
      id: "task_box",
      class: "box b1 container task-popup-list scroll-y-auto h-center"
    });
    popup.append(task_box);

    task_status_select.addEventListener("change", async () => {
      await updateTaskBox();
    });

    taskPopupRefresh = updateTaskBox;
    await updateTaskBox();

    return popup;
  }

  updateTaskBox = async () => {
    if (!task_box) { return; }

    task_box.innerHTML = "";

    let tasks = await taskFilter({
      status: task_status_select.value
    }) || [];
    tasks.sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0) || a.id - b.id);

    if (!tasks.length) {
      task_box.append(lib.element.create("div", {
        class: "box b1 lucida-grande bold padding-20 center"
      }, "Nenhuma tarefa"));
      return;
    }

    let milestones = await API.response(Milestone.filter, {});

    tasks.forEach(task => {
      let task_div = taskDiv(task, milestones);
      task_box.append(task_div);
    });
  };

  async function nextTaskSortOrder(status) {
    const tasks = await taskFilter({ status });
    if (!tasks || !tasks.length) { return 1; }

    return tasks.reduce((max, item) => Math.max(max, Number(item.sort_order) || 0), 0) + 1;
  }

  async function updateTaskOrder(container) {
    if (!container) { return; }

    let order = 1;

    for (const item of container.children) {
      if (!item.id || !String(item.id).startsWith("task-")) { continue; }

      await API.response(Task.update, {
        id: item.id.replace("task-", ""),
        sort_order: order
      }, "none");

      order++;
    }
  }

  function taskMoveIcon() {
    return lib.element.svg("b10 opacity-out-08 v-center grab", "18",
      `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-vertical-icon lucide-grip-vertical"><circle cx="9" cy="12" r="1"/><circle cx="9" cy="5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="19" r="1"/></svg>`
    );
  }

  function taskDiv(task, milestones) {
    let task_div = lib.element.create("div", {
      class: "mobile-box b2 container ground border shadow-st margin-top-10 padding-3 sortable-item",
    });

    task_div.id = `task-${task.id}`;

    let option_div = lib.element.create("div", {
      class: "container b1 right padding-3"
    });
    task_div.append(option_div);

    let milestone_select = lib.element.create("select", {
      class: "milestone-select mobile-box b6-10 lucida-grande rem08 border padding-3 v-center"
    });
    option_div.append(milestone_select);

    let default_option = lib.element.create("option", {
      value: "",
    }, "Selecione uma meta");
    milestone_select.append(default_option);

    milestones.forEach(milestone => {
      let option = lib.element.create("option", {
        value: milestone.id
      }, milestone.description);
      milestone_select.append(option);
    });

    milestone_select.value = task.milestone_id || "";

    let task_text = lib.element.create("textarea", {
      class: "mobile-box a1 height-100 lucida-grande rem08 border padding-3 v-center wrap",
      'data-initial_value': task.description
    }, task.description);
    task_div.append(task_text);

    let update_icon = lib.element.icon("b10 opacity-out-08 pointer",
      "20", "/images/icon/increase.png");
    option_div.append(update_icon);

    let delete_icon = lib.element.icon("b10 opacity-out-08 pointer",
      "20", "/images/icon/trash.png");
    option_div.append(delete_icon);

    let done_icon = lib.element.icon("b10 opacity-out-08 pointer",
      "20", "/images/icon/done.png");
    option_div.append(done_icon);

    let move_icon = taskMoveIcon();
    option_div.append(move_icon);

    lib.drag.element(task_div, async () => {
      await updateTaskOrder(task_box);
    }, move_icon, "g");

    lib.drag.drop(task_div, null, "drag-over", "g");

    done_icon.addEventListener("click", async () => {
      lib.confirm("Deseja concluir a tarefa?", async r => {
        if (!r) { return; }

        let updated_task = {
          id: task.id,
          status: "Concluído"
        };

        let response = await API.response(Task.update, updated_task);
        if (!response.done) { return; }

        lib.message(response.done, async () => {
          task_div.remove();
          await updateTaskOrder(task_box);
        });
      });
    });

    task_text.addEventListener("blur", async () => {
      if (task_text.value === task_text.dataset.initial_value) {
        return;
      }

      if (!task_text.value) {
        task_text.value = task_text.dataset.initial_value;
        return lib.message("O objetivo não pode ser vazio.");
      }

      let updated_task = {
        id: task.id,
        description: task_text.value
      };

      let response = await API.response(Task.update, updated_task);

      task_text.dataset.initial_value = task_text.value;
    });

    update_icon.addEventListener("click", async () => {
      lib.confirm("Deseja atualizar o objetivo?", async r => {
        if (!r) { return; }

        let updated_task = {
          id: task.id,
          status: "Em execução",
          sort_order: await nextTaskSortOrder("Em execução")
        };

        let response = await API.response(Task.update, updated_task);
        if (!response.done) { return; }

        let active_task_box = document.getElementById("active-task-box");

        task.status = "Em execução";
        task.sort_order = updated_task.sort_order;

        [...active_task_box.children].forEach(child => {
          if (!child.id) { child.remove(); }
        });

        let active_task_div = activeTaskDiv({
          ...task,
        }, milestones);

        active_task_box.append(active_task_div);
        task_div.remove();
        await updateTaskOrder(task_box);
      });
    });

    milestone_select.addEventListener("change", async () => {
      let task_updated = {
        id: task.id,
        milestone_id: milestone_select.value
      };

      let response = await API.response(Task.update, task_updated, milestone_select);
      if (!response.done) { return; }

      task.milestone_id = milestone_select.value;
    });

    delete_icon.addEventListener("click", async () => {
      lib.confirm("Deseja excluir a tarefa?", async r => {
        if (r) { return; }

        let response = await API.response(Task.delete, task.id);
        lib.message(response, async () => {
          task_div.remove();
          await updateTaskOrder(task_box);
        });
      }, "Não excluir", "Excluir tarefa");
    });

    subtaskSection(task).then(subtask_section => {
      task_div.append(subtask_section);
    });

    return task_div;
  }

  async function taskFilter(task) {
    let tasks = await API.response(Task.filter, task);
    if (!tasks) { return false; }

    return tasks;
  };
</script>
