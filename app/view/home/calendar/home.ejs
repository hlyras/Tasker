<div class="box b1 container margin-top-5 calendar-home-section">
  <button type="button" id="calendar-home-toggle"
    class="calendar-home-toggle mobile-box container pointer ground border padding-8"
    style="position: relative; flex-wrap: nowrap;"
    aria-expanded="false" aria-controls="calendar-home-panel">
    <span id="calendar-home-toggle-icon" class="calendar-home-toggle-icon"
      style="position: absolute; left: 8px; top: 50%; transform: translateY(-50%);">▶</span>
    <span class="box b1 lucida-grande rem08 bold center">Calendário</span>
  </button>

  <div id="calendar-home-panel" class="display-none">
    <div id="calendar-week-nav" class="box b1 container margin-top-10"></div>
    <div id="calendar-day-tabs" class="calendar-day-tabs box b1 container margin-bottom-10 margin-top-5"></div>
    <div id="calendar-home-container" class="box b1 container calendar-home"></div>
  </div>
</div>

<script>
  var calendarHomeDayIndex = 0;
  const CALENDAR_HOME_VISIBLE_KEY = "tasker-calendar-home-visible";

  function calendarSetHomeVisible(visible) {
    const panel = document.getElementById("calendar-home-panel");
    const toggle = document.getElementById("calendar-home-toggle");
    const icon = document.getElementById("calendar-home-toggle-icon");
    const section = document.querySelector(".calendar-home-section");
    if (!panel) { return; }

    panel.classList.toggle("display-none", !visible);
    section?.classList.toggle("is-open", visible);
    toggle?.setAttribute("aria-expanded", visible ? "true" : "false");
    if (icon) {
      icon.textContent = visible ? "▼" : "▶";
    }
    localStorage.setItem(CALENDAR_HOME_VISIBLE_KEY, visible ? "1" : "0");

    if (visible) {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (typeof calendarSyncAgendaScroll === "function") {
            calendarSyncAgendaScroll();
          }
        });
      });
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const toggle = document.getElementById("calendar-home-toggle");
    const visible = localStorage.getItem(CALENDAR_HOME_VISIBLE_KEY) === "1";

    calendarBuildHomeDayTabs();
    await calendarInitHome();
    calendarSetHomeVisible(visible);

    toggle?.addEventListener("click", () => {
      const is_hidden = document.getElementById("calendar-home-panel")?.classList.contains("display-none");
      calendarSetHomeVisible(is_hidden);
    });

    document.addEventListener("visibilitychange", async () => {
      if (document.hidden) { return; }
      if (!calendarWeekDidChange()) { return; }
      calendarGoToCurrentWeek();
      await calendarRenderHomeDay(calendarTodayIndex());
    });
  });

  function calendarBuildHomeDayTabs() {
    const tabs_container = document.getElementById("calendar-day-tabs");
    if (!tabs_container) { return; }

    calendarBuildWeekNav(document.getElementById("calendar-week-nav"), async () => {
      const day_index = calendarIsViewingCurrentWeek()
        ? calendarTodayIndex()
        : calendarHomeDayIndex;
      await calendarRenderHomeDay(day_index);
    });

    tabs_container.innerHTML = "";
    const days = calendarGetDays();

    days.forEach((day, index) => {
      const tab = lib.element.create("button", {
        type: "button",
        class: "calendar-day-tab mobile-box a7 lucida-grande rem07 bold border pointer ground padding-5 nowrap"
      }, calendarDayLabel(day));

      tab.addEventListener("click", async () => {
        if (calendarHomeDayIndex === index) { return; }
        await calendarRenderHomeDay(index);
      });

      tabs_container.append(tab);
    });
  }

  function calendarUpdateHomeDayTabs() {
    const tabs = document.querySelectorAll("#calendar-day-tabs .calendar-day-tab");
    tabs.forEach((tab, index) => {
      tab.classList.toggle("calendar-day-tab-active", index === calendarHomeDayIndex);
    });
  }
</script>
