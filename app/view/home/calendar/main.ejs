    getSchedule,
    onScheduleChange,
    onRefresh
  }) {
    let current_schedule = getSchedule();

    const groups = pending_subtasks.length
      ? await calendarGetActiveTaskSubtaskGroups(pending_subtasks)
      : [];

    const slot_subtask_ids = new Set(
      calendarGetSlotSubtasks(current_schedule, date_key, time)
    );
    const slot_session_ids = new Set(
      calendarGetSlotSessions(current_schedule, date_key, time)
    );
    const slot_avulsa_ids = new Set(
      calendarGetSlotAvulsas(current_schedule, date_key, time)
    );

    const available_sessions = pending_sessions.filter(
      session => !slot_session_ids.has(calendarNormalizeId(session.id))
    );
    const available_avulsas = pending_avulsas.filter(
      avulsa => !slot_avulsa_ids.has(calendarNormalizeId(avulsa.id))
    );

    let has_available_subtasks = false;

    groups.forEach(group => {
      const available = group.subtasks.filter(
        subtask => !slot_subtask_ids.has(calendarNormalizeId(subtask.id))
      );
      if (available.length) { has_available_subtasks = true; }
    });

    const popup_content = lib.element.create("div", {
      class: "box b1 container padding-10"
    });

    const title_box = lib.element.create("div", {
      class: "box b1 container h-center"
    });
    popup_content.append(title_box);

    title_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem09 padding-5 v-center"
    }, "Adicionar ao horário"));

    title_box.append(lib.element.create("img", {
      class: "image-prop size-20 v-center",
      src: "/images/icon/calendar.png"
    }));

    const slot_box = lib.element.create("div", {
      class: "box b1 container h-center margin-bottom-10"
    });
    popup_content.append(slot_box);

    slot_box.append(lib.element.create("img", {
      class: "image-prop size-18 v-center opacity-out-08",
      src: "/images/icon/time.png"
    }));
    slot_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande rem08 opacity-out-08 padding-5 v-center"
    }, calendarFormatSlotLabel(date_key, time)));

    const weekday_picker = calendarBuildWeekdayPicker(date_key);
    popup_content.append(weekday_picker.box);

    const tabs_box = lib.element.create("div", {
      class: "box b1 container border radius-5 margin-bottom-10",
      style: "overflow: hidden; background: var(--background);"
    });
    popup_content.append(tabs_box);

    const tab_class = "mobile-box a3 lucida-grande rem08 bold pointer padding-8 noborder";
    const tab_base_style = "text-align: center; border-radius: 0;";

    const tasks_tab = lib.element.create("button", {
      type: "button",
      class: tab_class,
      style: `${tab_base_style} border-right: 1px solid var(--light);`
    }, "Tarefas");
    tabs_box.append(tasks_tab);

    const workout_tab = lib.element.create("button", {
      type: "button",
      class: tab_class,
      style: `${tab_base_style} border-right: 1px solid var(--light);`
    }, "Treino");
    tabs_box.append(workout_tab);

    const avulsa_tab = lib.element.create("button", {
      type: "button",
      class: tab_class,
      style: tab_base_style
    }, "Avulsa");
    tabs_box.append(avulsa_tab);

    const tasks_panel = lib.element.create("div", {
      class: "box b1 container"
    });
    popup_content.append(tasks_panel);

    const workout_panel = lib.element.create("div", {
      class: "box b1 container",
      style: "display: none;"
    });
    popup_content.append(workout_panel);

    const avulsa_panel = lib.element.create("div", {
      class: "box b1 container",
      style: "display: none;"
    });
    popup_content.append(avulsa_panel);

    const tasks_list = lib.element.create("div", {
      class: "box b1 container ground border radius-5 scroll-y-auto",
      style: "max-height: 50vh;"
    });
    tasks_panel.append(tasks_list);

    const workout_list = lib.element.create("div", {
      class: "box b1 container ground border radius-5 scroll-y-auto",
      style: "max-height: 50vh;"
    });
    workout_panel.append(workout_list);

    const setActiveTab = tab => {
      const apply = (button, active, divider) => {
        button.style.background = active ? "var(--ground)" : "var(--background)";
        button.style.color = active ? "#245ae5" : "inherit";
        button.style.borderBottom = active ? "2px solid #245ae5" : "2px solid transparent";
        button.style.borderRight = divider ? "1px solid var(--light)" : "none";
      };

      apply(tasks_tab, tab === "tasks", true);
      apply(workout_tab, tab === "workout", true);
      apply(avulsa_tab, tab === "avulsa", false);
      tasks_panel.style.display = tab === "tasks" ? "" : "none";
      workout_panel.style.display = tab === "workout" ? "" : "none";
      avulsa_panel.style.display = tab === "avulsa" ? "" : "none";
    };

    tasks_tab.addEventListener("click", () => {
      setActiveTab("tasks");
    });

    workout_tab.addEventListener("click", () => {
      setActiveTab("workout");
    });

    avulsa_tab.addEventListener("click", () => {
      setActiveTab("avulsa");
    });

    if (has_available_subtasks) {
      groups.forEach(group => {
        const available_subtasks = group.subtasks.filter(
          subtask => !slot_subtask_ids.has(calendarNormalizeId(subtask.id))
        );

        if (!available_subtasks.length) { return; }

        const task_group = lib.element.create("div", {
          class: "box b1 container ground padding-5",
          style: "border-bottom: 1px solid var(--light);"
        });
        tasks_list.append(task_group);

        const task_title = lib.element.create("button", {
          type: "button",
          class: "box b1 lucida-grande rem08 bold padding-5 border pointer ground"
        }, group.task.description);
        task_group.append(task_title);

        if (group.task.milestone_description) {
          task_group.append(lib.element.create("div", {
            class: "box b1 lucida-grande rem07 opacity-out-08 padding-3"
          }, group.task.milestone_description));
        }

        const subtask_buttons = [];

        available_subtasks.forEach(subtask => {
          const subtask_button = calendarPickerItemRow({
            text: subtask.description,
            onClick: async event => {
              event.stopPropagation();

              const subtask_id = calendarNormalizeId(subtask.id);
              const weekdays = weekday_picker.getWeekdays();
              const next_schedule = calendarAddToWeekdays(
                current_schedule,
                time,
                weekdays,
                (schedule, slot_date, slot_time) => calendarAddSubtaskToSlot(schedule, slot_date, slot_time, subtask_id)
              );
              current_schedule = next_schedule;
              onScheduleChange(next_schedule);
              calendarRegisterRepeat("subtask", subtask_id, time, weekdays, weekday_picker.isEnabled());
              slot_subtask_ids.add(subtask_id);

              calendarPickerMarkAdded(subtask_button, subtask.description);

              if (subtask_buttons.every(item => item.subtask_button.style.pointerEvents === "none")) {
                task_title.disabled = true;
                task_title.classList.add("opacity-out-06", "line-through");
                task_title.textContent = `${group.task.description} (todas adicionadas)`;
              }

              await onRefresh();
            }
          });
          task_group.append(subtask_button);
          subtask_buttons.push({ subtask, subtask_button });
        });

        task_title.addEventListener("click", async event => {
          event.stopPropagation();

          const subtask_ids = available_subtasks.map(subtask => calendarNormalizeId(subtask.id));
          const weekdays = weekday_picker.getWeekdays();
          let next_schedule = current_schedule;

          subtask_ids.forEach(subtask_id => {
            next_schedule = calendarAddToWeekdays(
              next_schedule,
              time,
              weekdays,
              (schedule, slot_date, slot_time) => calendarAddSubtaskToSlot(schedule, slot_date, slot_time, subtask_id)
            );
            calendarRegisterRepeat("subtask", subtask_id, time, weekdays, weekday_picker.isEnabled());
          });

          current_schedule = next_schedule;
          onScheduleChange(next_schedule);

          subtask_ids.forEach(subtask_id => slot_subtask_ids.add(subtask_id));

          subtask_buttons.forEach(({ subtask, subtask_button }) => {
            calendarPickerMarkAdded(subtask_button, subtask.description);
          });

          task_title.disabled = true;
          task_title.classList.add("opacity-out-06", "line-through");
          task_title.textContent = `${group.task.description} (todas adicionadas)`;

          await onRefresh();
        });
      });
    } else {
      tasks_list.append(lib.element.create("div", {
        class: "box b1 lucida-grande rem08 padding-20 center opacity-out-08"
      }, "Nenhuma tarefa ativa com subtarefas pendentes"));
      tasks_tab.disabled = true;
      tasks_tab.classList.add("opacity-out-06");
    }

    if (available_sessions.length) {
      available_sessions.forEach(session => {
        workout_list.append(calendarSessionPickerCard(session, async card => {
          const session_id = calendarNormalizeId(session.id);
          const weekdays = weekday_picker.getWeekdays();
          const next_schedule = calendarAddToWeekdays(
            current_schedule,
            time,
            weekdays,
            (schedule, slot_date, slot_time) => calendarAddSessionToSlot(schedule, slot_date, slot_time, session_id)
          );
          current_schedule = next_schedule;
          onScheduleChange(next_schedule);
          calendarRegisterRepeat("session", session_id, time, weekdays, weekday_picker.isEnabled());
          slot_session_ids.add(session_id);

          card.style.pointerEvents = "none";
          card.classList.add("opacity-out-06");
          card.append(lib.element.create("div", {
            class: "box b1 lucida-grande rem07 opacity-out-08 margin-top-5"
          }, "Adicionada ao horário"));

          await onRefresh();
        }));
      });
    } else {
      workout_list.append(lib.element.create("div", {
        class: "box b1 lucida-grande rem08 padding-20 center opacity-out-08"
      }, "Nenhuma sessão de treino pendente"));
      workout_tab.disabled = true;
      workout_tab.classList.add("opacity-out-06");
    }

    const avulsa_create_box = lib.element.create("div", {
      class: "box b1 container ground border radius-5 padding-10 margin-bottom-10"
    });
    avulsa_panel.append(avulsa_create_box);

    const avulsa_form_title = lib.element.create("div", {
      class: "box b1 lucida-grande bold rem08 margin-bottom-5"
    }, "Nova tarefa avulsa");
    avulsa_create_box.append(avulsa_form_title);

    const avulsa_description_row = calendarPickerFieldRow("/images/icon/description.png");
    avulsa_create_box.append(avulsa_description_row);

    const avulsa_description_input = lib.element.create("input", {
      type: "text",
      class: "mobile-box flex-1 lucida-grande rem08 noborder padding-5",
      placeholder: "Ex: Ligar para o dentista, comprar leite..."
    });
    avulsa_description_row.append(avulsa_description_input);

    const avulsa_recurrence_row = calendarPickerFieldRow("/images/icon/refresh.png");
    avulsa_create_box.append(avulsa_recurrence_row);

    const avulsa_recurrence_select = lib.element.create("select", {
      class: "mobile-box flex-1 lucida-grande rem08 noborder padding-5"
    });
    avulsa_recurrence_row.append(avulsa_recurrence_select);

    avulsa_recurrence_select.append(lib.element.create("option", {
      value: "Unica"
    }, "Única"));

    avulsa_recurrence_select.append(lib.element.create("option", {
      value: "Recorrente"
    }, "Recorrente"));

    const avulsa_create_button = lib.element.create("button", {
      type: "button",
      class: "box b1 btn-act lucida-grande bold noborder radius-5 padding-8 pointer noselect"
    }, "+ Criar e adicionar ao horário");
    avulsa_create_box.append(avulsa_create_button);

    const avulsa_cancel_button = lib.element.create("button", {
      type: "button",
      class: "box b1 lucida-grande rem08 border pointer ground radius-5 padding-8 margin-top-5"
    }, "Cancelar");
    avulsa_cancel_button.style.display = "none";
    avulsa_create_box.append(avulsa_cancel_button);

    let editing_avulsa = null;
    let editing_row = null;

    const resetAvulsaForm = () => {
      editing_avulsa = null;
      editing_row = null;
      avulsa_form_title.textContent = "Nova tarefa avulsa";
      avulsa_create_button.textContent = "+ Criar e adicionar ao horário";
      avulsa_description_input.value = "";
      avulsa_recurrence_select.value = "Unica";
      avulsa_cancel_button.style.display = "none";
    };

    const startAvulsaEdit = (avulsa, row) => {
      editing_avulsa = avulsa;
      editing_row = row;
      avulsa_form_title.textContent = "Editar tarefa avulsa";
      avulsa_create_button.textContent = "Salvar alterações";
      avulsa_description_input.value = avulsa.description;
      avulsa_recurrence_select.value = calendarIsRecurringAvulsa(avulsa) ? "Recorrente" : "Unica";
      avulsa_cancel_button.style.display = "";
      avulsa_description_input.focus();
      avulsa_create_box.scrollIntoView({ block: "nearest" });
    };

    const saveAvulsaEdit = async () => {
      const description = avulsa_description_input.value.trim();
      if (!description) {
        return lib.message("Informe a descrição da tarefa avulsa.");
      }

      const recurrence_type = avulsa_recurrence_select.value === "Recorrente"
        ? "Recorrente"
        : "Unica";
      const was_recurring = calendarIsRecurringAvulsa(editing_avulsa);
      const response = await API.response(Avulsa.update, {
        id: editing_avulsa.id,
        description,
        recurrence_type
      });
      if (!response) { return; }

      editing_avulsa.description = description;
      editing_avulsa.recurrence_type = recurrence_type;

      if (was_recurring && recurrence_type !== "Recorrente") {
        calendarClearRepeat("avulsa", editing_avulsa.id);
      }

      if (editing_row?._pickerLabel) {
        editing_row._pickerLabel.textContent = description;
        editing_row._pickerLabel.classList.remove("line-through");
      }
      if (editing_row?._repeatIcon) {
        editing_row._repeatIcon.style.display = recurrence_type === "Recorrente" ? "" : "none";
      }

      await onRefresh();
      lib.message(response.done);
      resetAvulsaForm();
    };

    const createAvulsaAndAdd = async () => {
      if (editing_avulsa) {
        return saveAvulsaEdit();
      }

      const description = avulsa_description_input.value.trim();
      if (!description) {
        return lib.message("Informe a descrição da tarefa avulsa.");
      }

      const weekdays = weekday_picker.getWeekdays();
      const recurrence_type = weekday_picker.isEnabled() || avulsa_recurrence_select.value === "Recorrente"
        ? "Recorrente"
        : "Unica";

      const response = await API.response(Avulsa.create, {
        description,
        recurrence_type
      });
      if (!response) { return; }

      const avulsa = response.avulsa_task;
      const avulsa_id = calendarNormalizeId(avulsa.id);
      const next_schedule = calendarAddToWeekdays(
        current_schedule,
        time,
        weekdays,
        (schedule, slot_date, slot_time) => calendarAddAvulsaToSlot(schedule, slot_date, slot_time, avulsa_id)
      );
      current_schedule = next_schedule;
      onScheduleChange(next_schedule);
      calendarRegisterRepeat("avulsa", avulsa_id, time, weekdays, recurrence_type === "Recorrente");
      slot_avulsa_ids.add(avulsa_id);

      avulsa_description_input.value = "";
      pending_avulsas.unshift(avulsa);

      await onRefresh();
      lib.message(response.done);
    };

    avulsa_create_button.addEventListener("click", createAvulsaAndAdd);
    avulsa_cancel_button.addEventListener("click", resetAvulsaForm);
    avulsa_description_input.addEventListener("keydown", event => {
      if (event.key === "Enter") {
        event.preventDefault();
        createAvulsaAndAdd();
      }
    });

    if (available_avulsas.length) {
      const pendentes_title = lib.element.create("div", {
        class: "box b1 lucida-grande rem08 bold padding-3 margin-bottom-5"
      }, "Pendentes");
      avulsa_panel.append(pendentes_title);

      const avulsa_list = lib.element.create("div", {
        class: "box b1 container ground border radius-5 scroll-y-auto",
        style: "max-height: 35vh;"
      });
      avulsa_panel.append(avulsa_list);

      available_avulsas.forEach(avulsa => {
        const avulsa_button = calendarPickerItemRow({
          text: avulsa.description,
          show_repeat: calendarIsRecurringAvulsa(avulsa),
          onEdit: row => startAvulsaEdit(avulsa, row),
          onComplete: async () => {
            const avulsa_id = calendarNormalizeId(avulsa.id);
            const response = await API.response(Avulsa.update, {
              id: avulsa_id,
              status: "Concluído"
            });
            if (!response) { return; }

            if (editing_avulsa && calendarNormalizeId(editing_avulsa.id) === avulsa_id) {
              resetAvulsaForm();
            }

            avulsa_button.remove();
            if (!avulsa_list.children.length) {
              pendentes_title.remove();
              avulsa_list.remove();
            }

            await onRefresh();
          },
          onClick: async event => {
            event.stopPropagation();
            if (avulsa_button._added) { return; }

            const avulsa_id = calendarNormalizeId(avulsa.id);
            const weekdays = weekday_picker.getWeekdays();

            if (weekday_picker.isEnabled() && !calendarIsRecurringAvulsa(avulsa)) {
              await API.response(Avulsa.update, {
                id: avulsa_id,
                recurrence_type: "Recorrente"
              });
              avulsa.recurrence_type = "Recorrente";
              if (avulsa_button._repeatIcon) {
                avulsa_button._repeatIcon.style.display = "";
              }
            }

            const next_schedule = calendarAddToWeekdays(
              current_schedule,
              time,
              weekdays,
              (schedule, slot_date, slot_time) => calendarAddAvulsaToSlot(schedule, slot_date, slot_time, avulsa_id)
            );
            current_schedule = next_schedule;
            onScheduleChange(next_schedule);
            calendarRegisterRepeat("avulsa", avulsa_id, time, weekdays, calendarIsRecurringAvulsa(avulsa));
            slot_avulsa_ids.add(avulsa_id);

            avulsa_button._added = true;
            calendarPickerMarkAdded(avulsa_button, avulsa.description);

            await onRefresh();
          }
        });
        avulsa_list.append(avulsa_button);
      });
    }

    if (has_available_subtasks) {
      setActiveTab("tasks");
    } else if (available_sessions.length) {
      setActiveTab("workout");
    } else {
      setActiveTab("avulsa");
    }

    lib.popup(popup_content, async () => {
      await onRefresh();
    }, false, true);
  }
</script>
