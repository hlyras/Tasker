  }

  async function calendarGetCalendarSubtasks() {
    const subtasks = await API.response(Subtask.filter, {});
    return subtasks || [];
  }

  async function calendarGetPendingSessions() {
    const sessions = await API.response(Workout.filter, { status: "Pendente" });
    if (!sessions) { return []; }
    return sessions;
  }

  async function calendarGetCalendarAvulsas() {
    const avulsa_tasks = await API.response(Avulsa.filter, {});
    return avulsa_tasks || [];
  }

  function calendarIsRecurringAvulsa(avulsa) {
    return avulsa.recurrence_type === "Recorrente";
  }

  function calendarAvulsaLabel(avulsa) {
    if (calendarIsRecurringAvulsa(avulsa)) {
      return `${avulsa.description} ↻`;
    }

    return avulsa.description;
  }

  function calendarFormatSlotLabel(date_key, time) {
    const [year, month, day] = date_key.split("-").map(Number);
    const date = new Date(year, month - 1, day);
    const today_key = calendarDateKey(new Date());
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrow_key = calendarDateKey(tomorrow);

    let day_label;
    if (date_key === today_key) {
      day_label = "Hoje";
    } else if (date_key === tomorrow_key) {
      day_label = "Amanhã";
    } else {
      const weekdays = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];
      day_label = `${weekdays[date.getDay()]} ${String(day).padStart(2, "0")}/${String(month).padStart(2, "0")}`;
    }

    return `${day_label} às ${time}`;
  }

  async function calendarGetActiveTaskSubtaskGroups(pending_subtasks) {
    if (!pending_subtasks.length) { return []; }

    const active_tasks = await API.response(Task.filter, { status: "Em execução" });
    if (!active_tasks) { return []; }

    const task_map = new Map(
      active_tasks.map(task => [calendarNormalizeId(task.id), task])
    );

    const groups = new Map();

    pending_subtasks.forEach(subtask => {
      const task_id = calendarNormalizeId(subtask.task_id);
      const task = task_map.get(task_id);
      if (!task) { return; }

      if (!groups.has(task_id)) {
        groups.set(task_id, { task, subtasks: [] });
      }

      groups.get(task_id).subtasks.push(subtask);
    });

    return Array.from(groups.values())
      .sort((a, b) => (b.task.datetime || 0) - (a.task.datetime || 0));
  }

  let calendarHomeRefresh = null;
  var calendarPopupRerender = null;
  let calendarActiveWeekStart = null;
  let calendarAgendaScrollTop = null;
  let calendarAgendaDidCenterScroll = false;

  function calendarWeekDidChange() {
    const week_start = calendarDateKey(calendarGetWeekStart());
    if (calendarActiveWeekStart === week_start) { return false; }
    calendarActiveWeekStart = week_start;
    return true;
  }

  function calendarCenterCurrentSlot(body, row) {
    if (!body || !row) { return false; }

    const view_height = body.clientHeight;
    if (view_height < 40) { return false; }

    const max_scroll = body.scrollHeight - view_height;
    if (max_scroll <= 0) { return false; }

    const body_rect = body.getBoundingClientRect();
    const row_rect = row.getBoundingClientRect();
    const row_offset = row_rect.top - body_rect.top + body.scrollTop;
    const target = row_offset - ((view_height - row_rect.height) / 2);

    body.scrollTop = Math.max(0, Math.min(target, max_scroll));
    calendarAgendaScrollTop = body.scrollTop;
    calendarAgendaDidCenterScroll = true;
    return true;
  }

  function calendarApplyAgendaScroll(body, current_slot_row) {
    if (!body) { return; }

    if (!calendarAgendaDidCenterScroll) {
      calendarCenterCurrentSlot(body, current_slot_row);
      return;
    }

    if (calendarAgendaScrollTop != null) {
      body.scrollTop = calendarAgendaScrollTop;
    }
  }

  function calendarBindAgendaScroll(body) {
    body.addEventListener("scroll", () => {
      calendarAgendaScrollTop = body.scrollTop;
    }, { passive: true });
  }

  function calendarSyncAgendaScroll(attempt) {
    const body = document.querySelector("#calendar-home-container .calendar-body")
      || document.querySelector(".calendar-body");
    if (!body) { return; }

    calendarApplyAgendaScroll(body, body.querySelector(".calendar-row-current"));

    if (!calendarAgendaDidCenterScroll && (attempt || 0) < 12) {
      requestAnimationFrame(() => calendarSyncAgendaScroll((attempt || 0) + 1));
    }
  }

  function calendarBuildWeekNav(container, onWeekChange) {
    if (!container) { return; }

    container.innerHTML = "";

    const prev = lib.element.create("button", {
      type: "button",
      class: "mobile-box b10 pointer ground noborder padding-5",
      title: "Semana anterior"
    });
    prev.append(lib.element.create("img", {
      class: "image-prop size-18 center",
      src: "/images/icon/left-arrow.png"
    }));
    container.append(prev);

    const label = lib.element.create("div", {
      class: "mobile-box flex-1 lucida-grande rem08 bold center padding-5 v-center pointer",
      title: calendarIsViewingCurrentWeek() ? "" : "Voltar para esta semana"
    }, calendarWeekLabel());
    container.append(label);

    const next = lib.element.create("button", {
      type: "button",
      class: "mobile-box b10 pointer ground noborder padding-5",
      title: "Próxima semana"
    });
    next.append(lib.element.create("img", {
      class: "image-prop size-18 center",
      src: "/images/icon/right-arrow.png"
    }));
    container.append(next);

    prev.addEventListener("click", async () => {
      calendarShiftWeek(-1);
      await onWeekChange();
    });

    next.addEventListener("click", async () => {
      calendarShiftWeek(1);
      await onWeekChange();
    });

    label.addEventListener("click", async () => {
      if (calendarIsViewingCurrentWeek()) { return; }
      calendarGoToCurrentWeek();
      await onWeekChange();
    });
  }

  async function calendarBuildScheduleView(container, { days, grid_class = "" }) {
    await calendarEnsureHydrated();
    let schedule = calendarLoadSchedule();
    let calendar_subtasks = await calendarGetCalendarSubtasks();
    let pending_sessions = await calendarGetPendingSessions();
    let calendar_avulsas = await calendarGetCalendarAvulsas();
    let pending_subtasks = calendarPendingItems(calendar_subtasks);
    let pending_avulsas = calendarPendingItems(calendar_avulsas);
    const pending_map = new Map(
      calendar_subtasks.map(subtask => [calendarNormalizeId(subtask.id), subtask])
    );
    const session_map = new Map(
      pending_sessions.map(session => [calendarNormalizeId(session.id), session])
    );
    const avulsa_map = new Map(
      calendar_avulsas.map(avulsa => [calendarNormalizeId(avulsa.id), avulsa])
    );

    schedule = calendarPruneSchedule(
      schedule,
      calendarItemIds(calendar_subtasks),
      calendarItemIds(pending_sessions),
      calendarItemIds(calendar_avulsas)
    );

    const getSchedule = () => schedule;
    const shows_today = days.some(calendarIsToday);

    const grid = lib.element.create("div", {
      class: `box b1 container calendar-grid ${grid_class}`.trim()
    });
    container.append(grid);

    const header_row = lib.element.create("div", {
      class: "box b1 container calendar-header-row"
    });
    grid.append(header_row);

    header_row.append(lib.element.create("div", {
      class: "calendar-time-header"
    }));

    days.forEach(day => {
      header_row.append(lib.element.create("div", {
        class: `calendar-day-header ${calendarIsToday(day) ? "calendar-day-today" : ""}`
      }, calendarDayLabel(day)));
    });

    const body = lib.element.create("div", {
      class: "box b1 container calendar-body scroll-y-auto"
    });
    grid.append(body);
    calendarBindAgendaScroll(body);

    const time_slots = calendarGetTimeSlots();
    let current_slot_row = null;

    const now = new Date();
    const now_minutes = now.getHours() * 60 + now.getMinutes();
    const start_minutes = CALENDAR_START_HOUR * 60;
    const end_minutes = CALENDAR_END_HOUR * 60;
    let current_slot_index = -1;

    if (now_minutes >= start_minutes && now_minutes <= end_minutes) {
      current_slot_index = Math.floor((now_minutes - start_minutes) / 30);
    }

    const render = async () => {
      const previous_scroll_top = body.scrollTop;

      calendar_subtasks = await calendarGetCalendarSubtasks();
      pending_sessions = await calendarGetPendingSessions();
      calendar_avulsas = await calendarGetCalendarAvulsas();
      pending_subtasks = calendarPendingItems(calendar_subtasks);
      pending_avulsas = calendarPendingItems(calendar_avulsas);
      pending_map.clear();
      calendar_subtasks.forEach(subtask => {
        pending_map.set(calendarNormalizeId(subtask.id), subtask);
      });
      session_map.clear();
      pending_sessions.forEach(session => {
        session_map.set(calendarNormalizeId(session.id), session);
      });
      avulsa_map.clear();
      calendar_avulsas.forEach(avulsa => {
        avulsa_map.set(calendarNormalizeId(avulsa.id), avulsa);
      });
      schedule = calendarLoadSchedule();
      schedule = calendarPruneSchedule(
        schedule,
        calendarItemIds(calendar_subtasks),
        calendarItemIds(pending_sessions),
        calendarItemIds(calendar_avulsas)
      );
      schedule = calendarApplyRepeatsToWeek(
        schedule,
        {
          subtasks: calendarItemIds(calendar_subtasks),
          sessions: calendarItemIds(pending_sessions),
          avulsas: calendarItemIds(calendar_avulsas)
        },
        {
          subtasks: calendarItemIds(pending_subtasks),
          sessions: calendarItemIds(pending_sessions),
          avulsas: calendarItemIds(pending_avulsas)
        }
      );

      body.innerHTML = "";
      current_slot_row = null;

      time_slots.forEach((time, slot_index) => {
        const row = lib.element.create("div", {
          class: "box b1 container calendar-row"
        });

        if (shows_today && slot_index === current_slot_index) {
          row.classList.add("calendar-row-current");
          current_slot_row = row;
        }

        row.append(lib.element.create("div", {
          class: "calendar-time-label"
        }, time));

        days.forEach(day => {
          const date_key = calendarDateKey(day);
          const slot = calendarSlotDiv({
            date_key,
            time,
            getSchedule,
            pending_subtasks,
            pending_sessions,
            pending_avulsas,
            pending_map,
            session_map,
            avulsa_map,
            onScheduleChange: next_schedule => {
              schedule = next_schedule;
            },
            onRefresh: refreshViews
          });
          row.append(slot);
        });

        body.append(row);
      });

      requestAnimationFrame(() => {
        if (calendarAgendaDidCenterScroll) {
          body.scrollTop = calendarAgendaScrollTop != null ? calendarAgendaScrollTop : previous_scroll_top;
          return;
        }

        calendarApplyAgendaScroll(body, current_slot_row);
      });
    };

    const refreshViews = async () => {
      await render();
      if (calendarHomeRefresh && calendarHomeRefresh !== render) {
        await calendarHomeRefresh();
      }
    };

    await render();

    return render;
  }

  async function calendarRenderHomeDay(day_index) {
    const container = document.getElementById("calendar-home-container");
    if (!container) { return; }

    if (calendarWeekDidChange()) {
      calendarGoToCurrentWeek();
      day_index = calendarTodayIndex();
    }

    const all_days = calendarGetDays();
    const safe_index = all_days[day_index] ? day_index : calendarTodayIndex();

    calendarHomeDayIndex = safe_index;
    container.innerHTML = "";

    const day = all_days[safe_index];
    if (!day) { return; }

    if (typeof calendarBuildHomeDayTabs === "function") {
      calendarBuildHomeDayTabs();
    }

    calendarHomeRefresh = await calendarBuildScheduleView(container, {
      days: [day],
      grid_class: "calendar-grid-today"
    });

    calendarUpdateHomeDayTabs();
  }

  async function calendarInitHome() {
    await calendarEnsureHydrated();
    calendarGoToCurrentWeek();
    await calendarRenderHomeDay(calendarTodayIndex());
  }

  async function calendarPopup() {
    const popup = lib.element.create("div", {
      class: "box b1 container calendar-popup padding-10"
    });

    const title_box = lib.element.create("div", {
      class: "mobile-box container center margin-bottom-10"
    });
    popup.append(title_box);

    title_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem09 padding-5 v-center"
    }, "Calendário"));

    title_box.append(lib.element.create("img", {
      class: "image-prop size-25",
      src: "/images/icon/calendar.png"
    }));

    const week_nav = lib.element.create("div", {
      class: "box b1 container"
    });
    popup.append(week_nav);

    const day_tabs = lib.element.create("div", {
      class: "calendar-day-tabs box b1 container margin-bottom-10 margin-top-5"
    });
    popup.append(day_tabs);

    const grid_host = lib.element.create("div", {
      class: "box b1 container calendar-home"
    });
    popup.append(grid_host);

    let day_index = calendarTodayIndex();

    const renderDay = async (index) => {
      if (calendarWeekDidChange()) {
        calendarGoToCurrentWeek();
        index = calendarTodayIndex();
      }

      const days = calendarGetDays();
      const safe_index = days[index] ? index : calendarTodayIndex();
      day_index = safe_index;

      calendarBuildWeekNav(week_nav, async () => {
        const next_index = calendarIsViewingCurrentWeek()
          ? calendarTodayIndex()
          : day_index;
        await renderDay(next_index);
      });

      day_tabs.innerHTML = "";
      days.forEach((day, tab_index) => {
        const tab = lib.element.create("button", {
          type: "button",
          class: "calendar-day-tab mobile-box a7 lucida-grande rem07 bold border pointer ground padding-5 nowrap"
        }, calendarDayLabel(day));
        tab.classList.toggle("calendar-day-tab-active", tab_index === safe_index);
        tab.addEventListener("click", async () => {
          if (day_index === tab_index) { return; }
          await renderDay(tab_index);
        });
        day_tabs.append(tab);
      });

      grid_host.innerHTML = "";
      await calendarBuildScheduleView(grid_host, {
        days: [days[safe_index]],
        grid_class: "calendar-grid-today"
      });
    };

    calendarPopupRerender = () => renderDay(day_index);

    await calendarEnsureHydrated();
    calendarGoToCurrentWeek();
    await renderDay(calendarTodayIndex());

    return popup;
  }

  document.addEventListener("DOMContentLoaded", () => {
    calendarEnsureHydrated();
  });

  function calendarSlotDiv({
    date_key,
    time,
    getSchedule,
    pending_subtasks,
    pending_sessions,
    pending_avulsas,
    pending_map,
    session_map,
    avulsa_map,
    onScheduleChange,
    onRefresh
  }) {
    const slot = lib.element.create("div", {
      class: "calendar-slot pointer"
    });
    slot.dataset.dateKey = date_key;
    slot.dataset.time = time;

    const slot_items = calendarGetSlotItems(getSchedule(), date_key, time);
    calendarResolvedOrder(slot_items, time).forEach(key => {
      const entry = calendarParseOrderKey(key);
      if (!entry) { return; }
      const item_time = calendarGetItemExactTime(slot_items, entry.kind, entry.id, time);

      if (entry.kind === "subtask") {
        const subtask = pending_map.get(entry.id);
        if (!subtask) { return; }
        slot.append(calendarSubtaskChip({
          subtask,
          date_key,
          time,
          item_time,
          getSchedule,
          onScheduleChange,
          onRefresh
        }));
        return;
      }

      if (entry.kind === "session") {
        const session = session_map.get(entry.id);
        if (!session) { return; }
        slot.append(calendarSessionChip({
          session,
          date_key,
          time,
          item_time,
          getSchedule,
          onScheduleChange,
          onRefresh
        }));
        return;
      }

      const avulsa = avulsa_map.get(entry.id);
      if (!avulsa) { return; }
      slot.append(calendarAvulsaChip({
        avulsa,
        date_key,
        time,
        item_time,
        getSchedule,
        onScheduleChange,
        onRefresh
      }));
    });

    const add_button = lib.element.create("button", {
      type: "button",
      class: "calendar-slot-add lucida-grande rem07 border pointer ground"
    }, "+");
    slot.append(add_button);

    add_button.addEventListener("click", event => {
      event.stopPropagation();
      calendarOpenItemPicker({
        pending_subtasks,
        pending_sessions,
        pending_avulsas,
        date_key,
        time,
        getSchedule,
        onScheduleChange,
        onRefresh
      });
    });

    return slot;
  }

  function calendarChipActionRows() {
    const actions = lib.element.create("div", {
      class: "calendar-subtask-actions"
    });
    const status_row = lib.element.create("div", {
      class: "container",
      style: "flex-wrap: nowrap; gap: 4px;"
    });
    const manage_row = lib.element.create("div", {
      class: "container",
      style: "flex-wrap: nowrap; gap: 4px;"
    });
    actions.append(status_row);
    actions.append(manage_row);
    return { actions, status_row, manage_row };
  }

  function calendarChipTimeLabel(item_time) {
    const exact = calendarNormalizeClockTime(item_time);
    if (!exact) { return null; }
    return lib.element.create("div", {
      class: "lucida-grande rem065 bold opacity-out-08"
    }, exact);
  }

  function calendarSubtaskChip({
    subtask,
    date_key,
    time,
    item_time,
    getSchedule,
    onScheduleChange,
    onRefresh
  }) {
    const chip = lib.element.create("div", {
      class: "calendar-subtask-chip ground border"
    });

    const time_label = calendarChipTimeLabel(item_time || time);
    if (time_label) { chip.append(time_label); }

    const text = lib.element.create("div", {
      class: "calendar-subtask-text lucida-grande rem07"
    }, subtask.description);
    chip.append(text);

    const { actions, status_row, manage_row } = calendarChipActionRows();
    chip.append(actions);

    calendarBindChipStatus(status_row, {
      kind: "subtask",
      id: subtask.id,
      date_key,
      time,
      getSchedule,
      onScheduleChange,
      textEl: text
    });

    calendarAppendScheduleIcon(manage_row, {
      kind: "subtask",
      id: subtask.id,
      onRefresh,
      persist: async (date_key, slot_time) => {
        const due_date = date_key && slot_time
          ? lib.datetimeToTimestamp(`${date_key}T${slot_time}`)
          : null;

        if (date_key && slot_time && !due_date) {
          lib.message("O horário é inválido.");
          return false;
        }

        const response = await API.response(Subtask.update, {
          id: subtask.id,
          due_date
        });
        if (!response) { return false; }

        subtask.due_date = due_date;
        return true;
      }
    });

