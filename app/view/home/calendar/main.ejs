    }));
    container.append(prev);

    const label = lib.element.create("div", {
      class: "mobile-box flex-1 lucida-grande rem08 bold center padding-5 v-center pointer",
      title: calendarIsViewingCurrentWeek() ? "" : "Voltar para esta semana"
    }, calendarWeekLabel());
    container.append(label);

    const next = lib.element.create("button", {
      type: "button",
      class: "mobile-box b10 pointer ground noborder padding-5",
      title: "Próxima semana"
    });
    next.append(lib.element.create("img", {
      class: "image-prop size-18 center",
      src: "/images/icon/right-arrow.png"
    }));
    container.append(next);

    prev.addEventListener("click", async () => {
      calendarShiftWeek(-1);
      await onWeekChange();
    });

    next.addEventListener("click", async () => {
      calendarShiftWeek(1);
      await onWeekChange();
    });

    label.addEventListener("click", async () => {
      if (calendarIsViewingCurrentWeek()) { return; }
      calendarGoToCurrentWeek();
      await onWeekChange();
    });
  }

  async function calendarBuildScheduleView(container, { days, grid_class = "" }) {
    let schedule = calendarLoadSchedule();
    let calendar_subtasks = await calendarGetCalendarSubtasks();
    let pending_sessions = await calendarGetPendingSessions();
    let calendar_avulsas = await calendarGetCalendarAvulsas();
    let pending_subtasks = calendarPendingItems(calendar_subtasks);
    let pending_avulsas = calendarPendingItems(calendar_avulsas);
    const pending_map = new Map(
      calendar_subtasks.map(subtask => [calendarNormalizeId(subtask.id), subtask])
    );
    const session_map = new Map(
      pending_sessions.map(session => [calendarNormalizeId(session.id), session])
    );
    const avulsa_map = new Map(
      calendar_avulsas.map(avulsa => [calendarNormalizeId(avulsa.id), avulsa])
    );

    schedule = calendarPruneSchedule(
      schedule,
      calendarItemIds(calendar_subtasks),
      calendarItemIds(pending_sessions),
      calendarItemIds(calendar_avulsas)
    );

    const getSchedule = () => schedule;
    const shows_today = days.some(calendarIsToday);

    const grid = lib.element.create("div", {
      class: `box b1 container calendar-grid ${grid_class}`.trim()
    });
    container.append(grid);

    const header_row = lib.element.create("div", {
      class: "box b1 container calendar-header-row"
    });
    grid.append(header_row);

    header_row.append(lib.element.create("div", {
      class: "calendar-time-header"
    }));

    days.forEach(day => {
      header_row.append(lib.element.create("div", {
        class: `calendar-day-header ${calendarIsToday(day) ? "calendar-day-today" : ""}`
      }, calendarDayLabel(day)));
    });

    const body = lib.element.create("div", {
      class: "box b1 container calendar-body scroll-y-auto"
    });
    grid.append(body);
    calendarBindAgendaScroll(body);

    const time_slots = calendarGetTimeSlots();
    let current_slot_row = null;

    const now = new Date();
    const now_minutes = now.getHours() * 60 + now.getMinutes();
    const start_minutes = CALENDAR_START_HOUR * 60;
    const end_minutes = CALENDAR_END_HOUR * 60;
    let current_slot_index = -1;

    if (now_minutes >= start_minutes && now_minutes <= end_minutes) {
      current_slot_index = Math.floor((now_minutes - start_minutes) / 30);
    }

    const render = async () => {
      const previous_scroll_top = body.scrollTop;

      calendar_subtasks = await calendarGetCalendarSubtasks();
      pending_sessions = await calendarGetPendingSessions();
      calendar_avulsas = await calendarGetCalendarAvulsas();
      pending_subtasks = calendarPendingItems(calendar_subtasks);
      pending_avulsas = calendarPendingItems(calendar_avulsas);
      pending_map.clear();
      calendar_subtasks.forEach(subtask => {
        pending_map.set(calendarNormalizeId(subtask.id), subtask);
      });
      session_map.clear();
      pending_sessions.forEach(session => {
        session_map.set(calendarNormalizeId(session.id), session);
      });
      avulsa_map.clear();
      calendar_avulsas.forEach(avulsa => {
        avulsa_map.set(calendarNormalizeId(avulsa.id), avulsa);
      });
      schedule = calendarPruneSchedule(
        schedule,
        calendarItemIds(calendar_subtasks),
        calendarItemIds(pending_sessions),
        calendarItemIds(calendar_avulsas)
      );
      schedule = calendarApplyRepeatsToWeek(
        schedule,
        {
          subtasks: calendarItemIds(calendar_subtasks),
          sessions: calendarItemIds(pending_sessions),
          avulsas: calendarItemIds(calendar_avulsas)
        },
        {
          subtasks: calendarItemIds(pending_subtasks),
          sessions: calendarItemIds(pending_sessions),
          avulsas: calendarItemIds(pending_avulsas)
        }
      );

      body.innerHTML = "";
      current_slot_row = null;

      time_slots.forEach((time, slot_index) => {
        const row = lib.element.create("div", {
          class: "box b1 container calendar-row"
        });

        if (shows_today && slot_index === current_slot_index) {
          row.classList.add("calendar-row-current");
          current_slot_row = row;
        }

        row.append(lib.element.create("div", {
          class: "calendar-time-label"
        }, time));

        days.forEach(day => {
          const date_key = calendarDateKey(day);
          const slot = calendarSlotDiv({
            date_key,
            time,
            getSchedule,
            pending_subtasks,
            pending_sessions,
            pending_avulsas,
            pending_map,
            session_map,
            avulsa_map,
            onScheduleChange: next_schedule => {
              schedule = next_schedule;
            },
            onRefresh: refreshViews
          });
          row.append(slot);
        });

        body.append(row);
      });

      requestAnimationFrame(() => {
        if (calendarAgendaDidCenterScroll) {
          body.scrollTop = calendarAgendaScrollTop != null ? calendarAgendaScrollTop : previous_scroll_top;
          return;
        }

        calendarApplyAgendaScroll(body, current_slot_row);
      });
    };

    const refreshViews = async () => {
      await render();
      if (calendarHomeRefresh && calendarHomeRefresh !== render) {
        await calendarHomeRefresh();
      }
    };

    await render();

    return render;
  }

  async function calendarRenderHomeDay(day_index) {
    const container = document.getElementById("calendar-home-container");
    if (!container) { return; }

    if (calendarWeekDidChange()) {
      calendarGoToCurrentWeek();
      day_index = calendarTodayIndex();
    }

    const all_days = calendarGetDays();
    const safe_index = all_days[day_index] ? day_index : calendarTodayIndex();

    calendarHomeDayIndex = safe_index;
    container.innerHTML = "";

    const day = all_days[safe_index];
    if (!day) { return; }

    if (typeof calendarBuildHomeDayTabs === "function") {
      calendarBuildHomeDayTabs();
    }

    calendarHomeRefresh = await calendarBuildScheduleView(container, {
      days: [day],
      grid_class: "calendar-grid-today"
    });

    calendarUpdateHomeDayTabs();
  }

  async function calendarInitHome() {
    calendarGoToCurrentWeek();
    await calendarRenderHomeDay(calendarTodayIndex());
  }

