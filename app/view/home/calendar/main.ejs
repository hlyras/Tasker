<script>
  const CALENDAR_STORAGE_KEY = "tasker-calendar-schedule";
  const CALENDAR_WEEK_DAYS = 7;
  const CALENDAR_START_HOUR = 6;
  const CALENDAR_END_HOUR = 21;

  function calendarNormalizeId(id) {
    return parseInt(id, 10);
  }

  function calendarDateKey(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function calendarGetWeekStart(date = new Date()) {
    const start = new Date(date);
    start.setHours(0, 0, 0, 0);
    start.setDate(start.getDate() - start.getDay());
    return start;
  }

  let calendarViewedWeekStart = null;

  function calendarGetViewedWeekStart() {
    if (!calendarViewedWeekStart) {
      calendarViewedWeekStart = calendarGetWeekStart();
    }
    return new Date(calendarViewedWeekStart);
  }

  function calendarGoToCurrentWeek() {
    calendarViewedWeekStart = calendarGetWeekStart();
  }

  function calendarShiftWeek(offset_weeks) {
    const start = calendarGetViewedWeekStart();
    start.setDate(start.getDate() + (offset_weeks * CALENDAR_WEEK_DAYS));
    calendarViewedWeekStart = start;
  }

  function calendarIsViewingCurrentWeek() {
    return calendarDateKey(calendarGetViewedWeekStart()) === calendarDateKey(calendarGetWeekStart());
  }

  function calendarGetDays() {
    const start = calendarGetViewedWeekStart();
    const days = [];

    for (let i = 0; i < CALENDAR_WEEK_DAYS; i++) {
      const day = new Date(start);
      day.setDate(start.getDate() + i);
      days.push(day);
    }

    return days;
  }

  function calendarWeekLabel() {
    const days = calendarGetDays();
    const first = days[0];
    const last = days[days.length - 1];
    const format = date => {
      const day = String(date.getDate()).padStart(2, "0");
      const month = String(date.getMonth() + 1).padStart(2, "0");
      return `${day}/${month}`;
    };

    if (calendarIsViewingCurrentWeek()) {
      return "Esta semana";
    }

    return `${format(first)} — ${format(last)}`;
  }

  function calendarTodayIndex() {
    return new Date().getDay();
  }

  function calendarGetTimeSlots() {
    const slots = [];

    for (let hour = CALENDAR_START_HOUR; hour <= CALENDAR_END_HOUR; hour++) {
      slots.push(`${String(hour).padStart(2, "0")}:00`);
      if (hour < CALENDAR_END_HOUR) {
        slots.push(`${String(hour).padStart(2, "0")}:30`);
      }
    }

    return slots;
  }

  function calendarNormalizeClockTime(value) {
    const text = String(value || "").trim();
    const match = text.match(/^(\d{1,2}):(\d{2})(?::\d{2})?$/);
    if (!match) { return null; }

    const hour = Number(match[1]);
    const minute = Number(match[2]);
    if (hour < 0 || hour > 23 || minute < 0 || minute > 59) { return null; }

    return `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
  }

  function calendarTimeToMinutes(time) {
    const normalized = calendarNormalizeClockTime(time);
    if (!normalized) { return NaN; }
    const [hour, minute] = normalized.split(":").map(Number);
    return hour * 60 + minute;
  }

  function calendarMinutesToTime(total_minutes) {
    const minutes = ((Math.round(total_minutes) % (24 * 60)) + (24 * 60)) % (24 * 60);
    const hour = Math.floor(minutes / 60);
    const minute = minutes % 60;
    return `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
  }

  function calendarTimeToBlock(time) {
    const normalized = calendarNormalizeClockTime(time);
    if (!normalized) { return null; }

    let [hour, minute] = normalized.split(":").map(Number);
    minute = minute < 30 ? 0 : 30;

    const start = CALENDAR_START_HOUR * 60;
    const end = CALENDAR_END_HOUR * 60;
    let total = hour * 60 + minute;

    if (total < start) { total = start; }
    if (total > end) { total = end; }

    hour = Math.floor(total / 60);
    minute = total % 60;
    if (hour === CALENDAR_END_HOUR) { minute = 0; }
    else if (minute !== 0 && minute !== 30) { minute = minute < 30 ? 0 : 30; }

    return `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
  }

  function calendarCreateTimeInput(value, class_name) {
    return lib.element.create("input", {
      type: "time",
      step: "60",
      class: class_name || "box b1 lucida-grande rem09 border padding-8 margin-bottom-10",
      value: calendarNormalizeClockTime(value) || "08:00"
    });
  }

  function calendarReadTimeInput(input, fallback) {
    const value = calendarNormalizeClockTime(input && input.value);
    if (value) { return value; }
    return calendarNormalizeClockTime(fallback) || fallback || null;
  }

  function calendarGetItemExactTime(items, kind, id, fallback_time) {
    const key = calendarOrderKey(kind, id);
    const stored = items && items.times ? items.times[key] : null;
    return calendarNormalizeClockTime(stored)
      || calendarNormalizeClockTime(fallback_time)
      || fallback_time
      || null;
  }

  function calendarRememberItemTime(items, kind, id, time) {
    const exact = calendarNormalizeClockTime(time);
    if (!exact) { return items; }

    const key = calendarOrderKey(kind, id);
    items.times = { ...(items.times || {}) };
    items.times[key] = exact;
    return items;
  }

  function calendarDayLabel(date) {
    const today_key = calendarDateKey(new Date());
    const date_key = calendarDateKey(date);
    const tomorrow = new Date();
    tomorrow.setHours(0, 0, 0, 0);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrow_key = calendarDateKey(tomorrow);

    if (date_key === today_key) { return "Hoje"; }
    if (date_key === tomorrow_key) { return "Amanhã"; }

    const weekdays = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];
    const day = String(date.getDate()).padStart(2, "0");
    const month = String(date.getMonth() + 1).padStart(2, "0");

    return `${weekdays[date.getDay()]} ${day}/${month}`;
  }

  function calendarIsToday(date) {
    return calendarDateKey(date) === calendarDateKey(new Date());
  }

  function calendarLoadSchedule() {
    let schedule = {};

    try {
      schedule = JSON.parse(localStorage.getItem(CALENDAR_STORAGE_KEY) || "{}");
    } catch (error) {
      schedule = {};
    }

    return calendarCleanSchedule(schedule);
  }

  function calendarSaveSchedule(schedule) {
    const cleaned = calendarCleanSchedule(schedule);
    const next = JSON.stringify(cleaned);
    if (localStorage.getItem(CALENDAR_STORAGE_KEY) === next) { return cleaned; }

    localStorage.setItem(CALENDAR_STORAGE_KEY, next);
    calendarQueuePersist();
    return cleaned;
  }

  function calendarCleanSchedule(schedule) {
    const keep_start = calendarGetWeekStart();
    keep_start.setDate(keep_start.getDate() - (CALENDAR_WEEK_DAYS * 4));
    const keep_from_key = calendarDateKey(keep_start);
    const cleaned = {};

    Object.keys(schedule).forEach(date_key => {
      if (date_key < keep_from_key) { return; }

      const day_slots = schedule[date_key] || {};
      const cleaned_day = {};

      Object.keys(day_slots).forEach(time => {
        const normalized = calendarNormalizeSlot(day_slots[time]);

        if (normalized.subtasks.length || normalized.sessions.length || normalized.avulsas.length) {
          cleaned_day[time] = normalized;
        }
      });

      if (Object.keys(cleaned_day).length) {
        cleaned[date_key] = cleaned_day;
      }
    });

    return cleaned;
  }

  function calendarOrderKey(kind, id) {
    return `${kind}:${calendarNormalizeId(id)}`;
  }

  function calendarParseOrderKey(key) {
    const text = String(key || "");
    const split = text.indexOf(":");
    if (split <= 0) { return null; }
    const kind = text.slice(0, split);
    const id = calendarNormalizeId(text.slice(split + 1));
    if (!["subtask", "session", "avulsa"].includes(kind) || Number.isNaN(id)) { return null; }
    return { kind, id };
  }

  function calendarDefaultOrder(items) {
    const order = [];
    (items.subtasks || []).forEach(id => order.push(calendarOrderKey("subtask", id)));
    (items.sessions || []).forEach(id => order.push(calendarOrderKey("session", id)));
    (items.avulsas || []).forEach(id => order.push(calendarOrderKey("avulsa", id)));
    return order;
  }

  function calendarResolvedOrder(items, block_time) {
    const valid = new Set(calendarDefaultOrder(items));
    const seen = new Set();
    const order = [];

    (items.order || []).forEach(key => {
      const text = String(key);
      if (!valid.has(text) || seen.has(text)) { return; }
      seen.add(text);
      order.push(text);
    });

    calendarDefaultOrder(items).forEach(key => {
      if (seen.has(key)) { return; }
      seen.add(key);
      order.push(key);
    });

    const fallback = calendarNormalizeClockTime(block_time) || block_time || null;
    return order.slice().sort((a, b) => {
      const entry_a = calendarParseOrderKey(a);
      const entry_b = calendarParseOrderKey(b);
      if (!entry_a || !entry_b) { return 0; }

      const minutes_a = calendarTimeToMinutes(
        calendarGetItemExactTime(items, entry_a.kind, entry_a.id, fallback)
      );
      const minutes_b = calendarTimeToMinutes(
        calendarGetItemExactTime(items, entry_b.kind, entry_b.id, fallback)
      );

      if (minutes_a !== minutes_b) { return minutes_a - minutes_b; }
      return order.indexOf(a) - order.indexOf(b);
    });
  }

  function calendarNormalizeSlot(slot) {
    if (!slot) {
      return {
        subtasks: [],
        sessions: [],
        avulsas: [],
        completed_subtasks: [],
        completed_sessions: [],
        completed_avulsas: [],
        missed_subtasks: [],
        missed_sessions: [],
        missed_avulsas: []
      };
    }

    if (Array.isArray(slot)) {
      return {
        subtasks: slot.map(calendarNormalizeId).filter(id => !Number.isNaN(id)),
        sessions: [],
        avulsas: [],
        completed_subtasks: [],
        completed_sessions: [],
        completed_avulsas: [],
        missed_subtasks: [],
        missed_sessions: [],
        missed_avulsas: []
      };
    }

    const subtasks = (slot.subtasks || []).map(calendarNormalizeId).filter(id => !Number.isNaN(id));
    const sessions = (slot.sessions || []).map(calendarNormalizeId).filter(id => !Number.isNaN(id));
    const avulsas = (slot.avulsas || []).map(calendarNormalizeId).filter(id => !Number.isNaN(id));

    const completed_subtasks = (slot.completed_subtasks || [])
      .map(calendarNormalizeId)
      .filter(id => subtasks.includes(id));
    const completed_sessions = (slot.completed_sessions || [])
      .map(calendarNormalizeId)
      .filter(id => sessions.includes(id));
    const completed_avulsas = (slot.completed_avulsas || [])
      .map(calendarNormalizeId)
      .filter(id => avulsas.includes(id));

    const explicit_order = [];
    const seen_order = new Set();
    const valid_order = new Set(calendarDefaultOrder({ subtasks, sessions, avulsas }));
    (Array.isArray(slot.order) ? slot.order : []).forEach(key => {
      const text = String(key);
      if (!valid_order.has(text) || seen_order.has(text)) { return; }
      seen_order.add(text);
      explicit_order.push(text);
    });

    const times = {};
    if (slot.times && typeof slot.times === "object") {
      Object.keys(slot.times).forEach(key => {
        if (!valid_order.has(key)) { return; }
        const exact = calendarNormalizeClockTime(slot.times[key]);
        if (exact) { times[key] = exact; }
      });
    }

    const normalized = {
      subtasks,
      sessions,
      avulsas,
      completed_subtasks,
      completed_sessions,
      completed_avulsas,
      missed_subtasks: (slot.missed_subtasks || [])
        .map(calendarNormalizeId)
        .filter(id => subtasks.includes(id) && !completed_subtasks.includes(id)),
      missed_sessions: (slot.missed_sessions || [])
        .map(calendarNormalizeId)
        .filter(id => sessions.includes(id) && !completed_sessions.includes(id)),
      missed_avulsas: (slot.missed_avulsas || [])
        .map(calendarNormalizeId)
        .filter(id => avulsas.includes(id) && !completed_avulsas.includes(id))
    };

    if (explicit_order.length) { normalized.order = explicit_order; }
    if (Object.keys(times).length) { normalized.times = times; }
    return normalized;
  }

  function calendarGetSlotItems(schedule, date_key, time) {
    const day_slots = schedule[date_key] || {};
    const block = calendarTimeToBlock(time) || calendarNormalizeClockTime(time) || time;
    return calendarNormalizeSlot(day_slots[block]);
  }

  function calendarGetSlotSubtasks(schedule, date_key, time) {
    return calendarGetSlotItems(schedule, date_key, time).subtasks;
  }

  function calendarGetSlotSessions(schedule, date_key, time) {
    return calendarGetSlotItems(schedule, date_key, time).sessions;
  }

  function calendarGetSlotAvulsas(schedule, date_key, time) {
    return calendarGetSlotItems(schedule, date_key, time).avulsas;
  }

  function calendarSetSlotItems(schedule, date_key, time, items) {
    const next_schedule = { ...schedule };
    const day_slots = { ...(next_schedule[date_key] || {}) };
    const block = calendarTimeToBlock(time) || calendarNormalizeClockTime(time) || time;
    const normalized = calendarNormalizeSlot(items);

    if (!normalized.subtasks.length && !normalized.sessions.length && !normalized.avulsas.length) {
      delete day_slots[block];
    } else {
      day_slots[block] = normalized;
    }

    next_schedule[date_key] = day_slots;
    return calendarSaveSchedule(next_schedule);
  }

  function calendarAddSubtaskToSlot(schedule, date_key, time, subtask_id) {
    subtask_id = calendarNormalizeId(subtask_id);
    const exact = calendarNormalizeClockTime(time) || calendarTimeToBlock(time) || time;
    const items = calendarGetSlotItems(schedule, date_key, exact);

    if (!items.subtasks.includes(subtask_id)) {
      items.subtasks.push(subtask_id);
    }
    calendarRememberItemTime(items, "subtask", subtask_id, exact);

    return calendarSetSlotItems(schedule, date_key, exact, items);
  }

  function calendarAddSubtasksToSlot(schedule, date_key, time, subtask_ids) {
    const exact = calendarNormalizeClockTime(time) || calendarTimeToBlock(time) || time;
    const items = calendarGetSlotItems(schedule, date_key, exact);

    subtask_ids.forEach(subtask_id => {
      subtask_id = calendarNormalizeId(subtask_id);
      if (!items.subtasks.includes(subtask_id)) {
        items.subtasks.push(subtask_id);
      }
      calendarRememberItemTime(items, "subtask", subtask_id, exact);
    });

    return calendarSetSlotItems(schedule, date_key, exact, items);
  }

  function calendarSlotField(kind) {
    if (kind === "subtask") { return "subtasks"; }
    if (kind === "session") { return "sessions"; }
    return "avulsas";
  }

  function calendarCompletedField(kind) {
    if (kind === "subtask") { return "completed_subtasks"; }
    if (kind === "session") { return "completed_sessions"; }
    return "completed_avulsas";
  }

  function calendarMissedField(kind) {
    if (kind === "subtask") { return "missed_subtasks"; }
    if (kind === "session") { return "missed_sessions"; }
    return "missed_avulsas";
  }

  function calendarGetItemSlotStatus(schedule, date_key, time, kind, id) {
    id = calendarNormalizeId(id);
    const items = calendarGetSlotItems(schedule, date_key, time);
    if (items[calendarCompletedField(kind)].includes(id)) { return "complete"; }
    if (items[calendarMissedField(kind)].includes(id)) { return "missed"; }
    return "none";
  }

  function calendarIsItemCompletedInSlot(schedule, date_key, time, kind, id) {
    return calendarGetItemSlotStatus(schedule, date_key, time, kind, id) === "complete";
  }

  async function calendarSetItemSlotMark(schedule, date_key, time, kind, id, mark) {
    id = calendarNormalizeId(id);
    const items = calendarGetSlotItems(schedule, date_key, time);
    const completed_field = calendarCompletedField(kind);
    const missed_field = calendarMissedField(kind);
    const previous = calendarGetItemSlotStatus(schedule, date_key, time, kind, id);
    const next_status = previous === mark ? "none" : mark;

    items[completed_field] = items[completed_field].filter(item_id => item_id !== id);
    items[missed_field] = items[missed_field].filter(item_id => item_id !== id);

    if (next_status === "complete") {
      items[completed_field].push(id);
    } else if (next_status === "missed") {
      items[missed_field].push(id);
    }

    const next_schedule = calendarSetSlotItems(schedule, date_key, time, items);
    await calendarSyncOccurrenceXp(date_key, time, kind, id, next_status);
    return next_schedule;
  }

  const CALENDAR_XP_COMPLETE = 20;
  const CALENDAR_XP_MISSED = -20;
  const CALENDAR_XP_EVENTS_KEY = "tasker-calendar-xp-events";

  function calendarLoadXpEvents() {
    const events = calendarLoadJson(CALENDAR_XP_EVENTS_KEY, {});
    return events && typeof events === "object" ? events : {};
  }

  function calendarSaveXpEvents(events) {
    const next = JSON.stringify(events);
    if (localStorage.getItem(CALENDAR_XP_EVENTS_KEY) === next) { return; }

    localStorage.setItem(CALENDAR_XP_EVENTS_KEY, next);
    calendarQueuePersist();
  }

  function calendarXpEventKey(date_key, time, kind, id) {
    const block = calendarTimeToBlock(time) || calendarNormalizeClockTime(time) || time;
    return `${date_key}|${block}|${kind}|${calendarNormalizeId(id)}`;
  }

  async function calendarApplyXp(delta) {
    if (!delta) { return false; }

    if (typeof userApplyXpDelta === "function") {
      userApplyXpDelta(delta);
    }

    if (typeof User === "undefined" || typeof User.addXp !== "function") {
      return true;
    }

    const response = await API.response(User.addXp, { delta }, "none");
    if (response && !response.skipped && typeof response.xp === "number") {
      if (typeof userRenderXp === "function") {
        userRenderXp(response.xp);
      }
    }

    return true;
  }

  function calendarXpForStatus(status) {
    if (status === "complete") { return CALENDAR_XP_COMPLETE; }
    if (status === "missed") { return CALENDAR_XP_MISSED; }
    return 0;
  }

  function calendarXpEventState(events, key) {
    const value = events[key];
    if (!value) { return { complete: false, missed: false }; }
    if (value === "complete") { return { complete: true, missed: false }; }
    if (value === "late") { return { complete: false, missed: true }; }
    return {
      complete: Boolean(value.complete),
      missed: Boolean(value.missed || value.late)
    };
  }

  async function calendarSyncOccurrenceXp(date_key, time, kind, id, next_status) {
    const key = calendarXpEventKey(date_key, time, kind, id);
    const events = calendarLoadXpEvents();
    const state = calendarXpEventState(events, key);
    const previous_status = state.complete ? "complete" : state.missed ? "missed" : "none";
    const delta = calendarXpForStatus(next_status) - calendarXpForStatus(previous_status);

    if (delta && !(await calendarApplyXp(delta))) { return; }

    events[key] = {
      complete: next_status === "complete",
      missed: next_status === "missed"
    };
    calendarSaveXpEvents(events);
  }

  function calendarAddSessionToSlot(schedule, date_key, time, session_id) {
    session_id = calendarNormalizeId(session_id);
    const exact = calendarNormalizeClockTime(time) || calendarTimeToBlock(time) || time;
    const items = calendarGetSlotItems(schedule, date_key, exact);

    if (!items.sessions.includes(session_id)) {
      items.sessions.push(session_id);
    }
    calendarRememberItemTime(items, "session", session_id, exact);

    return calendarSetSlotItems(schedule, date_key, exact, items);
  }

  function calendarAddAvulsaToSlot(schedule, date_key, time, avulsa_id) {
    avulsa_id = calendarNormalizeId(avulsa_id);
    const exact = calendarNormalizeClockTime(time) || calendarTimeToBlock(time) || time;
    const items = calendarGetSlotItems(schedule, date_key, exact);

    if (!items.avulsas.includes(avulsa_id)) {
      items.avulsas.push(avulsa_id);
    }
    calendarRememberItemTime(items, "avulsa", avulsa_id, exact);

    return calendarSetSlotItems(schedule, date_key, exact, items);
  }

  const CALENDAR_REPEATS_KEY = "tasker-calendar-repeats";
  const CALENDAR_SEEDED_WEEKS_KEY = "tasker-calendar-seeded-weeks";
  const CALENDAR_WEEKDAY_LABELS = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];

  function calendarLoadJson(key, fallback) {
    try {
      return JSON.parse(localStorage.getItem(key) || "") || fallback;
    } catch (error) {
      return fallback;
    }
  }

  function calendarLoadRepeats() {
    const repeats = calendarLoadJson(CALENDAR_REPEATS_KEY, {});
    return repeats && typeof repeats === "object" ? repeats : {};
  }

  function calendarSaveRepeats(repeats) {
    const next = JSON.stringify(repeats);
    if (localStorage.getItem(CALENDAR_REPEATS_KEY) === next) { return; }

    localStorage.setItem(CALENDAR_REPEATS_KEY, next);
    calendarQueuePersist();
  }

  function calendarLoadSeededWeeks() {
    const seeded = calendarLoadJson(CALENDAR_SEEDED_WEEKS_KEY, []);
    return Array.isArray(seeded) ? seeded : [];
  }

  function calendarSaveSeededWeeks(seeded) {
    const next = JSON.stringify(seeded);
    if (localStorage.getItem(CALENDAR_SEEDED_WEEKS_KEY) === next) { return; }

    localStorage.setItem(CALENDAR_SEEDED_WEEKS_KEY, next);
    calendarQueuePersist();
  }

  let calendarPersistTimer = null;
  let calendarHydratePromise = null;
  let calendarCanPersist = false;
  let calendarPersistInFlight = false;
  let calendarApplyingServer = false;
  let calendarStateVersion = 0;

  function calendarReadLocalState() {
    return {
      schedule: calendarLoadJson(CALENDAR_STORAGE_KEY, {}),
      repeats: calendarLoadRepeats(),
      seeded_weeks: calendarLoadSeededWeeks(),
      xp_events: calendarLoadXpEvents()
    };
  }

  function calendarWriteLocalState(state) {
    localStorage.setItem(CALENDAR_STORAGE_KEY, JSON.stringify(state.schedule || {}));
    localStorage.setItem(CALENDAR_REPEATS_KEY, JSON.stringify(state.repeats || {}));
    localStorage.setItem(CALENDAR_SEEDED_WEEKS_KEY, JSON.stringify(
      Array.isArray(state.seeded_weeks) ? state.seeded_weeks : []
    ));
    localStorage.setItem(CALENDAR_XP_EVENTS_KEY, JSON.stringify(state.xp_events || {}));
    if (state.version != null) {
      calendarStateVersion = Number(state.version) || 0;
    }
  }

  async function calendarRefreshOpenViews() {
    if (typeof homeKanbanRefresh === "function") {
      await homeKanbanRefresh();
    }
    if (typeof calendarPopupRerender === "function") {
      await calendarPopupRerender();
    }
    if (typeof calendarRenderHomeDay === "function" && document.getElementById("calendar-home-container")) {
      const day_index = typeof calendarHomeDayIndex === "number"
        ? calendarHomeDayIndex
        : calendarTodayIndex();
      await calendarRenderHomeDay(day_index);
    }
  }

  async function calendarAdoptServerState(state, notify) {
    calendarApplyingServer = true;
    clearTimeout(calendarPersistTimer);
    calendarPersistTimer = null;
    calendarWriteLocalState(state);
    calendarApplyingServer = false;

    await calendarRefreshOpenViews();
    if (notify) {
      lib.message("A agenda foi atualizada em outro dispositivo.");
    }
  }

  async function calendarPersistState() {
    if (!calendarCanPersist || calendarApplyingServer || calendarPersistInFlight) { return; }
    if (typeof Calendar === "undefined" || typeof Calendar.save !== "function") { return; }

    calendarPersistInFlight = true;
    try {
      const response = await API.response(Calendar.save, {
        ...calendarReadLocalState(),
        version: calendarStateVersion
      }, "none");

      if (!response) { return; }
      if (response.conflict) {
        calendarPersistInFlight = false;
        await calendarAdoptServerState(response, true);
        return;
      }
      if (response.version != null) {
        calendarStateVersion = Number(response.version) || 0;
      }
    } finally {
      calendarPersistInFlight = false;
    }
  }

  function calendarQueuePersist() {
    if (!calendarCanPersist || calendarApplyingServer) { return; }
    clearTimeout(calendarPersistTimer);
    calendarPersistTimer = setTimeout(() => {
      calendarPersistTimer = null;
      calendarPersistState();
    }, 250);
  }

  async function calendarPullFromServer() {
    if (!calendarCanPersist || calendarApplyingServer || calendarPersistTimer || calendarPersistInFlight) {
      return;
    }
    if (typeof Calendar === "undefined" || typeof Calendar.find !== "function") { return; }

    const response = await API.response(Calendar.find, {}, "none");
    if (!response || !response.found) { return; }
    if ((Number(response.version) || 0) === calendarStateVersion) { return; }

    await calendarAdoptServerState(response, false);
  }

  async function calendarHydrateFromServer() {
    if (typeof Calendar === "undefined" || typeof Calendar.find !== "function") {
      calendarCanPersist = true;
      return;
    }

    const response = await API.response(Calendar.find, {}, "none");
    if (!response) {
      calendarHydratePromise = null;
      return;
    }

    if (response.skipped) {
      calendarCanPersist = true;
      return;
    }

    if (response.found) {
      calendarWriteLocalState(response);
      calendarCanPersist = true;
      return;
    }

    calendarStateVersion = 0;
    calendarCanPersist = true;
    await calendarPersistState();
  }

  function calendarEnsureHydrated() {
    if (!calendarHydratePromise) {
      calendarHydratePromise = calendarHydrateFromServer();
    }
    return calendarHydratePromise;
  }

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      clearTimeout(calendarPersistTimer);
      calendarPersistTimer = null;
      calendarPersistState();
      return;
    }

    if (!calendarCanPersist) {
      calendarHydratePromise = null;
      calendarEnsureHydrated().then(() => calendarRefreshOpenViews());
      return;
    }

    calendarPullFromServer();
  });

  function calendarRepeatKey(kind, id) {
    return `${kind}:${calendarNormalizeId(id)}`;
  }

  function calendarRegisterRepeat(kind, id, time, weekdays, force) {
    if (!weekdays || !weekdays.length) { return; }
    if (!force && weekdays.length < 2) { return; }

    const repeats = calendarLoadRepeats();
    repeats[calendarRepeatKey(kind, id)] = {
      time,
      weekdays: [...weekdays].sort((a, b) => a - b)
    };
    calendarSaveRepeats(repeats);
    calendarSaveSeededWeeks([calendarDateKey(calendarGetViewedWeekStart())]);
  }

  function calendarClearRepeat(kind, id) {
    const repeats = calendarLoadRepeats();
    delete repeats[calendarRepeatKey(kind, id)];
    calendarSaveRepeats(repeats);
  }

  function calendarHasRepeat(kind, id) {
    return Boolean(calendarLoadRepeats()[calendarRepeatKey(kind, id)]);
  }

  function calendarGetRepeat(kind, id) {
    return calendarLoadRepeats()[calendarRepeatKey(kind, id)] || null;
  }

  function calendarRemoveItemFromOtherSlots(schedule, kind, id, keep_date_key, keep_time) {
    id = calendarNormalizeId(id);
    const field = kind === "subtask" ? "subtasks" : kind === "session" ? "sessions" : "avulsas";
    const next_schedule = { ...schedule };
    const keep_block = calendarTimeToBlock(keep_time) || calendarNormalizeClockTime(keep_time) || keep_time;

    Object.keys(next_schedule).forEach(date_key => {
      const day_slots = { ...next_schedule[date_key] };

      Object.keys(day_slots).forEach(time => {
        if (date_key === keep_date_key && time === keep_block) { return; }

        const items = calendarNormalizeSlot(day_slots[time]);
        items[field] = items[field].filter(item_id => item_id !== id);

        if (!items.subtasks.length && !items.sessions.length && !items.avulsas.length) {
          delete day_slots[time];
        } else {
          day_slots[time] = items;
        }
      });

      next_schedule[date_key] = day_slots;
    });

    return calendarSaveSchedule(next_schedule);
  }

  function calendarAddToWeekdays(schedule, time, weekdays, add_one) {
    let next = schedule;

    calendarGetDays().forEach(day => {
      if (!weekdays.includes(day.getDay())) { return; }
      next = add_one(next, calendarDateKey(day), time);
    });

    return next;
  }

  function calendarApplyRepeatsToWeek(schedule, existing_ids, pending_ids, week_start) {
    const start = week_start ? new Date(week_start) : calendarGetViewedWeekStart();
    start.setHours(0, 0, 0, 0);
    const week_key = calendarDateKey(start);
    const seeded = calendarLoadSeededWeeks();
    if (seeded.includes(week_key)) {
      return schedule;
    }

    const repeats = calendarLoadRepeats();
    const stale = [];
    let next = schedule;

    for (let i = 0; i < CALENDAR_WEEK_DAYS; i++) {
      const day = new Date(start);
      day.setDate(start.getDate() + i);
      const weekday = day.getDay();
      const date_key = calendarDateKey(day);

      Object.keys(repeats).forEach(key => {
        const rule = repeats[key];
        if (!rule || !Array.isArray(rule.weekdays) || !rule.weekdays.includes(weekday)) {
          return;
        }

        const [kind, raw_id] = key.split(":");
        const id = calendarNormalizeId(raw_id);

        if (kind === "subtask") {
          if (!existing_ids.subtasks.has(id)) { stale.push(key); return; }
          if (!pending_ids.subtasks.has(id)) { return; }
          next = calendarAddSubtaskToSlot(next, date_key, rule.time, id);
          return;
        }

        if (kind === "session") {
          if (!existing_ids.sessions.has(id)) { stale.push(key); return; }
          next = calendarAddSessionToSlot(next, date_key, rule.time, id);
          return;
        }

        if (kind === "avulsa") {
          if (!existing_ids.avulsas.has(id)) { stale.push(key); return; }
          if (!pending_ids.avulsas.has(id)) { return; }
          next = calendarAddAvulsaToSlot(next, date_key, rule.time, id);
        }
      });
    }

    if (stale.length) {
      stale.forEach(key => {
        delete repeats[key];
      });
      calendarSaveRepeats(repeats);
    }

    seeded.push(week_key);
    calendarSaveSeededWeeks(seeded);
    return next;
  }

  function calendarSeedUpcomingWeeks(schedule, existing_ids, pending_ids, weeks = 4) {
    let next = schedule;
    const start = calendarGetWeekStart();

    for (let i = 0; i < weeks; i++) {
      const week = new Date(start);
      week.setDate(start.getDate() + (i * CALENDAR_WEEK_DAYS));
      next = calendarApplyRepeatsToWeek(next, existing_ids, pending_ids, week);
    }

    return next;
  }

  function calendarBuildWeekdayPicker(date_key, initial) {
    let anchor_weekday = calendarParseDateKey(date_key).getDay();
    const initial_days = initial && Array.isArray(initial.weekdays)
      ? initial.weekdays.map(day => Number(day)).filter(day => day >= 0 && day <= 6)
      : [];
    const selected = new Set(initial_days.length ? initial_days : [anchor_weekday]);
    const paints = [];
    let enabled = Boolean(initial && initial.enabled);

    const box = lib.element.create("div", {
      class: "box b1 container margin-bottom-10"
    });

    const header = lib.element.create("div", {
      class: "box b1 container",
      style: "flex-wrap: nowrap;"
    });
    box.append(header);

    header.append(lib.element.create("div", {
      class: "mobile-box flex-1 lucida-grande rem08 bold padding-3 v-center"
    }, "Repetir nos dias"));

    const switch_row = lib.element.create("div", {
      class: "mobile-box container border radius-5",
      style: "overflow: hidden; flex-wrap: nowrap;"
    });
    header.append(switch_row);

    const off_button = lib.element.create("button", {
      type: "button",
      class: "mobile-box lucida-grande rem07 bold pointer padding-5 noborder"
    }, "Off");
    switch_row.append(off_button);

    const on_button = lib.element.create("button", {
      type: "button",
      class: "mobile-box lucida-grande rem07 bold pointer padding-5 noborder",
      style: "border-left: 1px solid var(--light);"
    }, "On");
    switch_row.append(on_button);

    const days_box = lib.element.create("div", {
      class: "box b1 display-none"
    });
    box.append(days_box);

    days_box.append(lib.element.create("div", {
      class: "box b1 lucida-grande rem07 opacity-out-08 padding-3 margin-bottom-5"
    }, "Marque os dias que devem receber este horário"));

    const row = lib.element.create("div", {
      class: "box b1 container"
    });
    days_box.append(row);

    const paintSwitch = () => {
      off_button.style.background = enabled ? "var(--ground)" : "#245ae5";
      off_button.style.color = enabled ? "inherit" : "#fff";
      on_button.style.background = enabled ? "#245ae5" : "var(--ground)";
      on_button.style.color = enabled ? "#fff" : "inherit";
      days_box.classList.toggle("display-none", !enabled);
    };

    const setEnabled = value => {
      enabled = value;
      paintSwitch();
    };

    off_button.addEventListener("click", () => setEnabled(false));
    on_button.addEventListener("click", () => setEnabled(true));
    paintSwitch();

    CALENDAR_WEEKDAY_LABELS.forEach((label, weekday) => {
      const button = lib.element.create("button", {
        type: "button",
        class: "mobile-box a7 lucida-grande rem07 bold border pointer padding-5 nowrap"
      }, label);

      const paint = () => {
        const active = selected.has(weekday);
        button.style.background = active ? "#245ae5" : "var(--ground)";
        button.style.color = active ? "#fff" : "inherit";
        button.style.borderColor = active ? "#245ae5" : "";
      };

      paint();
      paints.push(paint);

      button.addEventListener("click", () => {
        if (selected.has(weekday)) {
          if (selected.size === 1) { return; }
          selected.delete(weekday);
        } else {
          selected.add(weekday);
        }
        paints.forEach(fn => fn());
      });

      row.append(button);
    });

    return {
      box,
      isEnabled: () => enabled,
      setEnabled,
      getWeekdays: () => {
        if (!enabled) { return [anchor_weekday]; }

        return CALENDAR_WEEKDAY_LABELS
          .map((_, weekday) => weekday)
          .filter(weekday => selected.has(weekday));
      },
      setAnchor: weekday => {
        anchor_weekday = weekday;
        if (enabled) { return; }
        selected.clear();
        selected.add(weekday);
        paints.forEach(fn => fn());
      }
    };
  }

  async function calendarOpenItemSchedule({ kind, id, canClear, persist, onDone, recurrenceType, onRecurrenceChange }) {
    const slot = calendarFindItemSlot(kind, id);
    const repeat = calendarGetRepeat(kind, id);
    const popup = lib.element.create("div", {
      class: "box b1 container padding-15 subtask-deadline-popup"
    });

    popup.append(lib.element.create("div", {
      class: "box b1 lucida-grande bold rem09 padding-5 center margin-bottom-10"
    }, "Horário no calendário"));

    const date_input = lib.element.create("input", {
      type: "date",
      class: "box b1 lucida-grande rem09 border padding-8 margin-bottom-10"
    });
    popup.append(date_input);

    const today = new Date();
    const slots = calendarGetTimeSlots();
    const minutes = today.getHours() * 60 + today.getMinutes();
    const upcoming = slots.find(time => {
      const [hour, minute] = time.split(":").map(Number);
      return hour * 60 + minute >= minutes;
    });
    const now_time = calendarMinutesToTime(minutes);
    date_input.value = slot ? slot.date_key : calendarDateKey(today);
    const initial_time = (slot && (slot.item_time || slot.time))
      || (repeat && repeat.time)
      || now_time
      || upcoming
      || slots[slots.length - 1];
    const time_input = calendarCreateTimeInput(initial_time);
    popup.append(time_input);

    let recurrence_select = null;
    if (kind === "avulsa") {
      const recurrence_row = calendarPickerFieldRow("/images/icon/refresh.png");
      recurrence_row.classList.add("margin-bottom-10");
      popup.append(recurrence_row);

      recurrence_select = lib.element.create("select", {
        class: "mobile-box flex-1 lucida-grande rem08 noborder padding-5"
      });
      recurrence_row.append(recurrence_select);
      recurrence_select.append(lib.element.create("option", { value: "Unica" }, "Única"));
      recurrence_select.append(lib.element.create("option", { value: "Recorrente" }, "Recorrente"));
      recurrence_select.value = recurrenceType === "Recorrente" || repeat ? "Recorrente" : "Unica";
    }

    const weekday_picker = calendarBuildWeekdayPicker(date_input.value, repeat ? {
      enabled: true,
      weekdays: repeat.weekdays
    } : null);
    popup.append(weekday_picker.box);

    if (recurrence_select) {
      if (recurrence_select.value === "Recorrente") {
        weekday_picker.setEnabled(true);
      }
      recurrence_select.addEventListener("change", () => {
        weekday_picker.setEnabled(recurrence_select.value === "Recorrente");
      });
    }

    date_input.addEventListener("change", () => {
      if (!date_input.value) { return; }
      weekday_picker.setAnchor(calendarParseDateKey(date_input.value).getDay());
    });

    const save_button = lib.element.create("button", {
      type: "button",
      class: "box b1 btn-act lucida-grande bold noborder padding-8 margin-bottom-5 pointer"
    }, "Colocar no calendário");
    popup.append(save_button);

    const finish = async () => {
      if (typeof onDone === "function") { await onDone(); }
      lib.popout();
      if (typeof calendarPopupRerender === "function") {
        await calendarPopupRerender();
      }
      if (typeof homeKanbanRefresh === "function") {
        await homeKanbanRefresh();
      }
    };

    const applySchedule = async (date_key, time) => {
      if (typeof persist === "function") {
        const saved = await persist(date_key, time);
        if (!saved) { return; }
      }

      let repeat_enabled = Boolean(date_key && time && weekday_picker.isEnabled());
      if (recurrence_select && date_key && time) {
        repeat_enabled = weekday_picker.isEnabled() || recurrence_select.value === "Recorrente";
        const recurrence_type = repeat_enabled ? "Recorrente" : "Unica";
        const response = await API.response(Avulsa.update, {
          id,
          recurrence_type
        });
        if (!response) { return; }
        if (typeof onRecurrenceChange === "function") {
          onRecurrenceChange(recurrence_type);
        }
      }

      calendarScheduleItem(
        kind,
        id,
        date_key,
        time,
        weekday_picker.getWeekdays(),
        repeat_enabled
      );
      await finish();
    };

    save_button.addEventListener("click", async () => {
      if (!date_input.value) {
        return lib.message("Informe o dia.");
      }
      const chosen_time = calendarReadTimeInput(time_input);
      if (!chosen_time) {
        return lib.message("Informe o horário.");
      }
      await applySchedule(date_input.value, chosen_time);
    });

    if (slot || repeat || canClear) {
      const clear_button = lib.element.create("button", {
        type: "button",
        class: "box b1 lucida-grande rem08 border padding-8 pointer ground"
      }, "Tirar do calendário");
      popup.append(clear_button);
      clear_button.addEventListener("click", async () => {
        await applySchedule(null, null);
      });
    }

    lib.popup(popup, null, false, true);
  }

  function calendarParseDateKey(date_key) {
    const [year, month, day] = date_key.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function calendarRemoveSubtaskFromSlot(schedule, date_key, time, subtask_id) {
    subtask_id = calendarNormalizeId(subtask_id);
    const items = calendarGetSlotItems(schedule, date_key, time);
    items.subtasks = items.subtasks.filter(id => id !== subtask_id);

    return calendarSetSlotItems(schedule, date_key, time, items);
  }

  function calendarRemoveSessionFromSlot(schedule, date_key, time, session_id) {
    session_id = calendarNormalizeId(session_id);
    const items = calendarGetSlotItems(schedule, date_key, time);
    items.sessions = items.sessions.filter(id => id !== session_id);

    return calendarSetSlotItems(schedule, date_key, time, items);
  }

  function calendarRemoveAvulsaFromSlot(schedule, date_key, time, avulsa_id) {
    avulsa_id = calendarNormalizeId(avulsa_id);
    const items = calendarGetSlotItems(schedule, date_key, time);
    items.avulsas = items.avulsas.filter(id => id !== avulsa_id);

    return calendarSetSlotItems(schedule, date_key, time, items);
  }

  function calendarMoveXpEvent(date_key, from_time, to_time, kind, id) {
    const events = calendarLoadXpEvents();
    const from_key = calendarXpEventKey(date_key, from_time, kind, id);
    const to_key = calendarXpEventKey(date_key, to_time, kind, id);
    if (!events[from_key] || from_key === to_key) { return; }
    if (!events[to_key]) { events[to_key] = events[from_key]; }
    delete events[from_key];
    calendarSaveXpEvents(events);
  }

  function calendarUpdateRepeatTime(kind, id, from_time, to_time) {
    if (!calendarHasRepeat(kind, id)) { return; }
    const repeats = calendarLoadRepeats();
    const rule = repeats[calendarRepeatKey(kind, id)];
    if (!rule) { return; }

    const rule_time = calendarNormalizeClockTime(rule.time) || rule.time;
    const from_exact = calendarNormalizeClockTime(from_time) || from_time;
    const from_block = calendarTimeToBlock(from_time);
    if (rule_time !== from_exact && rule_time !== from_block) { return; }

    rule.time = calendarNormalizeClockTime(to_time) || to_time;
    calendarSaveRepeats(repeats);
  }

  function calendarMoveItemTime(schedule, kind, id, from_time, to_time) {
    const from_block = calendarTimeToBlock(from_time) || calendarNormalizeClockTime(from_time) || from_time;
    const to_block = calendarTimeToBlock(to_time) || calendarNormalizeClockTime(to_time) || to_time;
    if (!from_block || !to_block || from_block === to_block) { return schedule; }

    id = calendarNormalizeId(id);
    const field = calendarSlotField(kind);
    const completed_field = calendarCompletedField(kind);
    const missed_field = calendarMissedField(kind);
    const moves = [];

    Object.keys(schedule).forEach(date_key => {
      const items = calendarGetSlotItems(schedule, date_key, from_block);
      if (!items[field].includes(id)) { return; }
      moves.push({
        date_key,
        status: calendarGetItemSlotStatus(schedule, date_key, from_block, kind, id),
        exact: calendarGetItemExactTime(items, kind, id, from_block)
      });
    });

    if (!moves.length) { return schedule; }

    let next = schedule;
    moves.forEach(({ date_key, status, exact }) => {
      const source = calendarGetSlotItems(next, date_key, from_block);
      source[field] = source[field].filter(item_id => item_id !== id);
      source[completed_field] = source[completed_field].filter(item_id => item_id !== id);
      source[missed_field] = source[missed_field].filter(item_id => item_id !== id);
      next = calendarSetSlotItems(next, date_key, from_block, source);

      const target = calendarGetSlotItems(next, date_key, to_block);
      target[completed_field] = target[completed_field].filter(item_id => item_id !== id);
      target[missed_field] = target[missed_field].filter(item_id => item_id !== id);
      if (!target[field].includes(id)) { target[field].push(id); }
      if (status === "complete") { target[completed_field].push(id); }
      else if (status === "missed") { target[missed_field].push(id); }

      const offset = Math.max(0, Math.min(29,
        calendarTimeToMinutes(exact) - calendarTimeToMinutes(from_block)
      ));
      const next_exact = Number.isNaN(offset)
        ? to_block
        : calendarMinutesToTime(calendarTimeToMinutes(to_block) + offset);
      calendarRememberItemTime(target, kind, id, next_exact);

      next = calendarSetSlotItems(next, date_key, to_block, target);
      calendarMoveXpEvent(date_key, from_block, to_block, kind, id);
    });

    calendarUpdateRepeatTime(kind, id, from_time, to_time);
    return next;
  }

  function calendarReorderSlot(schedule, date_key, time, kind, id, before_key) {
    const block = calendarTimeToBlock(time) || calendarNormalizeClockTime(time) || time;
    const items = calendarGetSlotItems(schedule, date_key, block);
    const key = calendarOrderKey(kind, id);
    const current = calendarResolvedOrder(items, block);
    if (!current.includes(key)) { return schedule; }

    const next_order = current.filter(item => item !== key);
    if (before_key && before_key !== key) {
      const index = next_order.indexOf(before_key);
      if (index === -1) { next_order.push(key); }
      else { next_order.splice(index, 0, key); }
    } else {
      next_order.push(key);
    }

    const same = current.length === next_order.length
      && current.every((item, index) => item === next_order[index]);
    if (same) { return schedule; }

    items.order = next_order;

    const index = next_order.indexOf(key);
    const prev_key = index > 0 ? next_order[index - 1] : null;
    const next_key = index < next_order.length - 1 ? next_order[index + 1] : null;
    const block_start = calendarTimeToMinutes(block);
    const block_end = block_start + 29;
    const prev_entry = prev_key ? calendarParseOrderKey(prev_key) : null;
    const next_entry = next_key ? calendarParseOrderKey(next_key) : null;
    const prev_minutes = prev_entry
      ? calendarTimeToMinutes(calendarGetItemExactTime(items, prev_entry.kind, prev_entry.id, block))
      : block_start - 1;
    const next_minutes = next_entry
      ? calendarTimeToMinutes(calendarGetItemExactTime(items, next_entry.kind, next_entry.id, block))
      : block_end + 1;

    let placed = Math.floor((prev_minutes + next_minutes) / 2);
    if (!(next_minutes - prev_minutes >= 2)) {
      placed = Math.min(block_end, Math.max(block_start, prev_minutes + 1));
    }
    placed = Math.min(block_end, Math.max(block_start, placed));
    calendarRememberItemTime(items, kind, id, calendarMinutesToTime(placed));

    return calendarSetSlotItems(schedule, date_key, block, items);
  }

  function calendarRemoveSubtaskFromAllSlots(schedule, subtask_id) {
    subtask_id = calendarNormalizeId(subtask_id);
    const next_schedule = { ...schedule };

    Object.keys(next_schedule).forEach(date_key => {
      const day_slots = { ...next_schedule[date_key] };

      Object.keys(day_slots).forEach(time => {
        const items = calendarNormalizeSlot(day_slots[time]);
        items.subtasks = items.subtasks.filter(id => id !== subtask_id);

        if (!items.subtasks.length && !items.sessions.length && !items.avulsas.length) {
          delete day_slots[time];
        } else {
          day_slots[time] = items;
        }
      });

      next_schedule[date_key] = day_slots;
    });

    return calendarSaveSchedule(next_schedule);
  }

  function calendarRemoveSessionFromAllSlots(schedule, session_id) {
    session_id = calendarNormalizeId(session_id);
    const next_schedule = { ...schedule };

    Object.keys(next_schedule).forEach(date_key => {
      const day_slots = { ...next_schedule[date_key] };

      Object.keys(day_slots).forEach(time => {
        const items = calendarNormalizeSlot(day_slots[time]);
        items.sessions = items.sessions.filter(id => id !== session_id);

        if (!items.subtasks.length && !items.sessions.length && !items.avulsas.length) {
          delete day_slots[time];
        } else {
          day_slots[time] = items;
        }
      });

      next_schedule[date_key] = day_slots;
    });

    return calendarSaveSchedule(next_schedule);
  }

  function calendarRemoveAvulsaFromAllSlots(schedule, avulsa_id) {
    avulsa_id = calendarNormalizeId(avulsa_id);
    const next_schedule = { ...schedule };

    Object.keys(next_schedule).forEach(date_key => {
      const day_slots = { ...next_schedule[date_key] };

      Object.keys(day_slots).forEach(time => {
        const items = calendarNormalizeSlot(day_slots[time]);
        items.avulsas = items.avulsas.filter(id => id !== avulsa_id);

        if (!items.subtasks.length && !items.sessions.length && !items.avulsas.length) {
          delete day_slots[time];
        } else {
          day_slots[time] = items;
        }
      });

      next_schedule[date_key] = day_slots;
    });

    return calendarSaveSchedule(next_schedule);
  }

  function calendarFindItemSlot(kind, id) {
    const schedule = calendarLoadSchedule();
    const field = calendarSlotField(kind);
    const normalized = calendarNormalizeId(id);
    const dates = Object.keys(schedule).sort();

    for (let i = 0; i < dates.length; i++) {
      const date_key = dates[i];
      const times = Object.keys(schedule[date_key] || {}).sort();

      for (let j = 0; j < times.length; j++) {
        const time = times[j];
        const items = calendarNormalizeSlot(schedule[date_key][time]);
        if (items[field].includes(normalized)) {
          return {
            date_key,
            time,
            item_time: calendarGetItemExactTime(items, kind, normalized, time)
          };
        }
      }
    }

    return null;
  }

  function calendarScheduleItem(kind, id, date_key, time, weekdays, repeat_enabled) {
    const remove = kind === "avulsa"
      ? calendarRemoveAvulsaFromAllSlots
      : kind === "session"
        ? calendarRemoveSessionFromAllSlots
        : calendarRemoveSubtaskFromAllSlots;
    const add = kind === "avulsa"
      ? calendarAddAvulsaToSlot
      : kind === "session"
        ? calendarAddSessionToSlot
        : calendarAddSubtaskToSlot;
    let schedule = remove(calendarLoadSchedule(), id);

    if (!date_key || !time) {
      calendarClearRepeat(kind, id);
      return schedule;
    }

    schedule = add(schedule, date_key, time, id);

    if (repeat_enabled && weekdays && weekdays.length) {
      const start = calendarGetWeekStart(calendarParseDateKey(date_key));
      weekdays.forEach(weekday => {
        for (let i = 0; i < 7; i++) {
          const day = new Date(start);
          day.setDate(start.getDate() + i);
          if (day.getDay() !== weekday) { continue; }
          const key = calendarDateKey(day);
          if (key === date_key) { continue; }
          schedule = add(schedule, key, time, id);
        }
      });
      calendarRegisterRepeat(kind, id, time, weekdays, true);
      return schedule;
    }

    calendarClearRepeat(kind, id);
    return schedule;
  }

  function calendarPruneSchedule(schedule, valid_subtask_ids, valid_session_ids, valid_avulsa_ids) {
    const lists_missing = !valid_subtask_ids.size && !valid_session_ids.size && !valid_avulsa_ids.size;
    const has_items = Object.keys(schedule || {}).some(date_key => {
      const day_slots = schedule[date_key] || {};
      return Object.keys(day_slots).some(time => {
        const items = calendarNormalizeSlot(day_slots[time]);
        return items.subtasks.length || items.sessions.length || items.avulsas.length;
      });
    });
    if (lists_missing && has_items) { return schedule; }

    const next_schedule = { ...schedule };

    Object.keys(next_schedule).forEach(date_key => {
      const day_slots = { ...next_schedule[date_key] };

      Object.keys(day_slots).forEach(time => {
        const items = calendarNormalizeSlot(day_slots[time]);
        items.subtasks = items.subtasks.filter(id => valid_subtask_ids.has(id));
        items.sessions = items.sessions.filter(id => valid_session_ids.has(id));
        items.avulsas = items.avulsas.filter(id => valid_avulsa_ids.has(id));

        if (!items.subtasks.length && !items.sessions.length && !items.avulsas.length) {
          delete day_slots[time];
        } else {
          day_slots[time] = items;
        }
      });

      next_schedule[date_key] = day_slots;
    });

    return calendarSaveSchedule(next_schedule);
  }

  function calendarItemIds(items) {
    return new Set((items || []).map(item => calendarNormalizeId(item.id)));
  }

  function calendarIsCompleted(item) {
    return item.status === "Concluído";
  }

  function calendarPendingItems(items) {
    return (items || []).filter(item => !calendarIsCompleted(item));
  }

  function calendarPaintChipStatus(text, done_icon, miss_icon, status) {
    const completed = status === "complete";
    const missed = status === "missed";

    text.classList.toggle("line-through", completed);
    text.classList.toggle("opacity-out-06", completed || missed);
    text.style.color = missed ? "#b91c1c" : "";

    if (done_icon) {
      done_icon.classList.toggle("opacity-out-04", completed);
    }
    if (miss_icon) {
      miss_icon.classList.toggle("opacity-out-04", missed);
    }
  }

  function calendarBindChipStatus(actions, {
    kind,
    id,
    date_key,
    time,
    getSchedule,
    onScheduleChange,
    textEl
  }) {
    const done_icon = lib.element.icon("calendar-subtask-action opacity-out-08 pointer",
      "20", "/images/icon/done.png");
    done_icon.title = "Concluído";
    actions.append(done_icon);

    const paint = schedule => {
      calendarPaintChipStatus(
        textEl,
        done_icon,
        null,
        calendarGetItemSlotStatus(schedule, date_key, time, kind, id)
      );
    };

    paint(getSchedule());

    done_icon.addEventListener("click", async event => {
      event.stopPropagation();
      const next_schedule = await calendarSetItemSlotMark(
        getSchedule(), date_key, time, kind, id, "complete"
      );
      onScheduleChange(next_schedule);
      paint(next_schedule);
    });
  }

  function calendarAppendScheduleIcon(actions, { kind, id, persist, onRefresh, recurrenceType, onRecurrenceChange }) {
    const icon = lib.element.icon("calendar-subtask-action opacity-10 pointer",
      "20", "/images/icon/calendar.png");
