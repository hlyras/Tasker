<script>
  function workoutFormatExercise(exercise) {
    if (exercise.km != null && exercise.km !== "") {
      return `${exercise.name} — ${parseFloat(exercise.km)} km`;
    }

    return `${exercise.name} — ${exercise.reps} reps`;
  }

  function workoutExerciseRow(exercise = {}) {
    const row = lib.element.create("div", {
      class: "box b1 container workout-exercise-row ground border radius-5 padding-10 margin-bottom-5"
    });

    const name_input = lib.element.create("input", {
      type: "text",
      class: "box b1 lucida-grande rem08 border padding-5",
      placeholder: "Exercício",
      value: exercise.name || ""
    });
    row.append(name_input);

    const details = lib.element.create("div", {
      class: "box b1 container margin-top-5",
      style: "flex-wrap: nowrap;"
    });
    row.append(details);

    const measure_select = lib.element.create("select", {
      class: "mobile-box b4 lucida-grande rem08 border padding-5"
    });
    measure_select.append(lib.element.create("option", { value: "reps" }, "Reps"));
    measure_select.append(lib.element.create("option", { value: "km" }, "Km"));
    details.append(measure_select);

    const value = exercise.km != null && exercise.km !== ""
      ? parseFloat(exercise.km)
      : exercise.reps || "";

    if (exercise.km != null && exercise.km !== "") {
      measure_select.value = "km";
    }

    const value_input = lib.element.create("input", {
      type: "number",
      min: "0",
      step: "any",
      class: "mobile-box flex-1 lucida-grande rem08 border padding-5 margin-left-5",
      placeholder: "Qtd",
      value: value
    });
    details.append(value_input);

    const remove_button = lib.element.create("button", {
      type: "button",
      class: "mobile-box b10 lucida-grande rem08 border pointer ground margin-left-5",
      title: "Remover exercício"
    }, "×");
    details.append(remove_button);

    remove_button.addEventListener("click", () => {
      row.remove();
    });

    row.getExerciseData = () => ({
      name: name_input.value.trim(),
      measure_type: measure_select.value,
      value: value_input.value
    });

    return row;
  }

  function workoutCollectExercises(exercises_box) {
    return Array.from(exercises_box.querySelectorAll(".workout-exercise-row"))
      .map(row => row.getExerciseData())
      .filter(exercise => exercise.name);
  }

  function workoutEditorBox(session, { title_text, button_text, onSubmit, onCancel }) {
    const box = lib.element.create("div", {
      class: "box b1 container workout-create-box ground border radius-5 padding-10"
    });

    box.append(lib.element.create("div", {
      class: "box b1 lucida-grande bold rem08 margin-bottom-5"
    }, title_text));

    const name_input = lib.element.create("input", {
      type: "text",
      class: "box b1 lucida-grande rem08 border padding-5 margin-bottom-10",
      placeholder: "Nome da sessão (ex: Treino A, Corrida)",
      value: session?.name || ""
    });
    box.append(name_input);

    const exercises_box = lib.element.create("div", {
      class: "box b1 container workout-exercises-box margin-bottom-5"
    });
    box.append(exercises_box);

    const exercises = session?.exercises || [];
    if (exercises.length) {
      exercises.forEach(exercise => exercises_box.append(workoutExerciseRow(exercise)));
    } else {
      exercises_box.append(workoutExerciseRow());
    }

    const add_exercise_button = lib.element.create("button", {
      type: "button",
      class: "box b1 lucida-grande rem08 bold pointer padding-8 margin-bottom-10 radius-5",
      style: "border: 1px dashed #245ae5; color: #245ae5; background: var(--ground);"
    }, "+ Exercício");
    box.append(add_exercise_button);

    add_exercise_button.addEventListener("click", () => {
      exercises_box.append(workoutExerciseRow());
    });

    const save_button = lib.element.create("button", {
      type: "button",
      class: "box b1 btn-act lucida-grande bold noborder radius-5 padding-10 pointer noselect"
    }, button_text);
    box.append(save_button);

    if (onCancel) {
      const cancel_button = lib.element.create("button", {
        type: "button",
        class: "box b1 lucida-grande rem08 border pointer ground radius-5 padding-10 margin-top-5"
      }, "Cancelar");
      box.append(cancel_button);
      cancel_button.addEventListener("click", onCancel);
    }

    save_button.addEventListener("click", async () => {
      const name = name_input.value.trim();
      const collected = workoutCollectExercises(exercises_box);

      if (!name) {
        return lib.message("Informe o nome da sessão de treino.");
      }

      if (!collected.length) {
        return lib.message("Adicione pelo menos um exercício.");
      }

      await onSubmit({ name, exercises: collected });
    });

    return box;
  }

  async function workoutSaveSession(payload, session) {
    if (session?.id) {
      return API.response(Workout.update, {
        id: session.id,
        name: payload.name,
        exercises: payload.exercises
      });
    }

    return API.response(Workout.create, payload);
  }

  async function workoutOpenEditPopup(session, onSaved) {
    const popup = lib.element.create("div", {
      class: "box b1 container h-center"
    });

    const menu = lib.element.create("div", {
      class: "box b2-3 container padding-10"
    });
    popup.append(menu);

    const title_box = lib.element.create("div", {
      class: "mobile-box container center margin-bottom-10"
    });
    menu.append(title_box);

    title_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem09 padding-5 v-center"
    }, "Editar treino"));

    title_box.append(lib.element.create("img", {
      class: "image-prop size-25",
      src: "/images/icon/workout.png"
    }));

    menu.append(workoutEditorBox(session, {
      title_text: "Editar sessão de treino",
      button_text: "Salvar alterações",
      onSubmit: async payload => {
        const response = await workoutSaveSession(payload, session);
        if (!response) { return; }

        lib.message(response.done, async () => {
          lib.popout();
          if (onSaved) { await onSaved(); }
        });
      },
      onCancel: () => lib.popout()
    }));

    lib.popup(popup, false, true);
  }

  async function workoutPopup() {
    const popup = lib.element.create("div", {
      class: "box b1 container h-center"
    });

    const menu = lib.element.create("div", {
      class: "box b2-3 container padding-10"
    });
    popup.append(menu);

    const title_box = lib.element.create("div", {
      class: "mobile-box container center margin-bottom-10"
    });
    menu.append(title_box);

    title_box.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem09 padding-5 v-center"
    }, "Treino"));

    title_box.append(lib.element.create("img", {
      class: "image-prop size-25",
      src: "/images/icon/workout.png"
    }));

    const sessions_box = lib.element.create("div", {
      id: "workout-sessions-box",
      class: "box b1 container workout-sessions-box scroll-y-auto margin-bottom-10"
    });
    menu.append(sessions_box);

    const editor_host = lib.element.create("div", {
      class: "box b1 container"
    });
    menu.append(editor_host);

    const renderSessions = async () => {
      sessions_box.innerHTML = "";

      const sessions = await API.response(Workout.filter, { status: "Pendente" });
      if (!sessions) { return; }

      if (!sessions.length) {
        sessions_box.append(lib.element.create("div", {
          class: "box b1 lucida-grande bold padding-20 center opacity-out-08"
        }, "Nenhuma sessão de treino pendente"));
        return;
      }

      sessions.forEach(session => {
        sessions_box.append(workoutSessionDiv(session, {
          onRefresh: renderSessions,
          onEdit: session_to_edit => mountEditor(session_to_edit)
        }));
      });
    };

    const mountEditor = session => {
      editor_host.innerHTML = "";
      editor_host.append(workoutEditorBox(session, {
        title_text: session ? "Editar sessão de treino" : "Nova sessão de treino",
        button_text: session ? "Salvar alterações" : "Salvar sessão",
        onSubmit: async payload => {
          const response = await workoutSaveSession(payload, session);
          if (!response) { return; }

          lib.message(response.done, async () => {
            mountEditor(null);
            await renderSessions();
          });
        },
        onCancel: session ? () => mountEditor(null) : null
      }));

      if (session) {
        editor_host.scrollIntoView({ block: "nearest" });
      }
    };

    mountEditor(null);
    await renderSessions();

    return popup;
  }

  function workoutSessionDiv(session, { onRefresh, onEdit }) {
    const session_div = lib.element.create("div", {
      class: "box b2 container workout-session-item ground border radius-5 padding-10 margin-bottom-10"
    });

    const header = lib.element.create("div", {
      class: "box b1 container",
      style: "flex-wrap: nowrap;"
    });
    session_div.append(header);

    const info = lib.element.create("div", {
      class: "mobile-box flex-1"
    });
    header.append(info);

    info.append(lib.element.create("div", {
      class: "box b1 lucida-grande rem08 bold wrap"
    }, session.name));

    (session.exercises || []).forEach(exercise => {
      info.append(lib.element.create("div", {
        class: "box b1 lucida-grande rem07 opacity-out-08 margin-top-5 wrap"
      }, workoutFormatExercise(exercise)));
    });

    const actions = lib.element.create("div", {
      class: "mobile-box container",
      style: "flex-wrap: nowrap;"
    });
    header.append(actions);

    const edit_button = lib.element.create("button", {
      type: "button",
      class: "mobile-box pointer border radius-5 padding-5 margin-left-5",
      style: "background: var(--background);",
      title: "Editar sessão"
    });
    edit_button.append(lib.element.create("img", {
      class: "image-prop size-18",
      src: "/images/icon/edit.png"
    }));
    actions.append(edit_button);

    const delete_button = lib.element.create("button", {
      type: "button",
      class: "mobile-box pointer border radius-5 padding-5 margin-left-5",
      style: "background: #fee2e2; border-color: #fecaca;",
      title: "Excluir sessão"
    });
    delete_button.append(lib.element.create("img", {
      class: "image-prop size-18",
      src: "/images/icon/trash.png"
    }));
    actions.append(delete_button);

    edit_button.addEventListener("click", () => {
      onEdit(session);
    });

    delete_button.addEventListener("click", async () => {
      lib.confirm("Deseja excluir a sessão de treino?", async r => {
        if (r) { return; }

        const response = await API.response(Workout.delete, session.id);
        lib.message(response, async () => {
          await onRefresh();
        });
      }, "Não excluir", "Excluir sessão");
    });

    return session_div;
  }
</script>
