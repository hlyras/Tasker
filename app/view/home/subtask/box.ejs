<script>
  async function subtaskSection(task) {
    let section = lib.element.create("div", {
      class: "box b1 container margin-top-5 padding-5 border-top"
    });

    let title_row = lib.element.create("div", {
      class: "box b1 container pointer"
    });
    section.append(title_row);

    title_row.append(lib.element.create("div", {
      class: "mobile-box lucida-grande bold rem08 padding-5 v-center"
    }, "Subtarefas"));

    let toggle_icon = lib.element.icon("opacity-out-08 pointer v-center",
      "16", "/images/icon/down-arrow.png");
    title_row.append(toggle_icon);

    let content = lib.element.create("div", {
      class: "box b1 display-none"
    });
    section.append(content);

    let container = lib.element.create("div", {
      id: `subtask-container-${task.id}`,
      class: "box b1 container subtask-container"
    });
    content.append(container);

    let add_row = lib.element.create("div", {
      class: "box b1 container margin-top-5"
    });
    content.append(add_row);

    title_row.addEventListener("click", () => {
      const is_open = !content.classList.contains("display-none");
      content.classList.toggle("display-none", is_open);

      const img = toggle_icon.querySelector("img");
      if (img) {
        img.src = is_open ? "/images/icon/down-arrow.png" : "/images/icon/up-arrow.png";
      }
    });

    let add_input = lib.element.create("textarea", {
      class: "mobile-box b4-5 lucida-grande rem08 border padding-5 wrap",
      placeholder: "Nova subtarefa..."
    });
    add_row.append(add_input);

    let add_button = lib.element.create("button", {
      class: "mobile-box b5 lucida-grande rem08 border padding-5 pointer ground"
    }, "+");
    add_row.append(add_button);

    add_button.addEventListener("click", async () => {
      await createSubtask(task.id, add_input, container);
    });

    let subtasks = await API.response(Subtask.filter, { task_id: task.id });
    if (!subtasks) { return section; }

    subtasks.forEach(subtask => {
      let subtask_div = subtaskDiv(subtask, task.id, container);
      container.append(subtask_div);
    });

    return section;
  }

  async function createSubtask(task_id, add_input, container) {
    if (!add_input.value.trim()) {
      return lib.message("Informe a descrição da subtarefa.");
    }

    let sort_order = container.children.length + 1;

    let response = await API.response(Subtask.create, {
      task_id,
      description: add_input.value.trim(),
      sort_order
    });

    if (!response || !response.subtask) { return; }

    let subtask_div = subtaskDiv(response.subtask, task_id, container);
    container.append(subtask_div);
    add_input.value = "";
  }

  async function updateSubtaskOrder(container) {
    let subtask_divs = container.children;

    for (let i in subtask_divs) {
      if (!subtask_divs[i].id) { continue; }

      let subtask_id = subtask_divs[i].id.replace("subtask-", "");

      await API.response(Subtask.update, {
        id: subtask_id,
        sort_order: parseInt(i) + 1
      }, "none");
    }
  }

  function subtaskDiv(subtask, task_id, container) {
    let subtask_div = lib.element.create("div", {
      class: "box b1 container subtask-item ground border padding-3 margin-top-3"
    });

    subtask_div.id = `subtask-${subtask.id}`;

    let description_input = lib.element.create("textarea", {
      class: `mobile-box flex-1 lucida-grande rem08 border padding-3 v-center wrap ${subtask.status === "Concluído" ? "line-through opacity-out-06" : ""}`,
      'data-initial_value': subtask.description
    }, subtask.description);
    subtask_div.append(description_input);

    let deadline = lib.element.create("div", {
      class: "subtask-deadline",
      title: "Horário no calendário"
    });
    subtask_div.append(deadline);

    let deadline_icon = lib.element.svg("b10 padding-5 pointer v-center", "18",
      `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 14v2.2l1.6 1"/><path d="M16 2v3"/><path d="M21 7.338V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2.338"/><path d="M3 9h5.859"/><path d="M8 2v3"/><circle cx="16" cy="16" r="6"/></svg>`
    );
    deadline.append(deadline_icon);
    renderSubtaskDeadline(subtask, deadline_icon);

    deadline.addEventListener("click", () => {
      openSubtaskDeadline(subtask, deadline_icon);
    });

    let delete_icon = lib.element.svg("b10 padding-5 opacity-out-08 pointer v-center", "18",
      `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`
    );
    subtask_div.append(delete_icon);

    let done_icon = lib.element.icon("mobile-box b10 padding-5 opacity-out-08 pointer v-center",
      "18", "/images/icon/done.png");
    if (subtask.status === "Concluído") {
      done_icon.classList.add("opacity-out-04");
    }
    subtask_div.append(done_icon);

    let move_icon = lib.element.svg("mobile-box b10 padding-5 opacity-out-08 v-center grab", "18",
      `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-vertical-icon lucide-grip-vertical"><circle cx="9" cy="12" r="1"/><circle cx="9" cy="5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="19" r="1"/></svg>`
    );
    subtask_div.append(move_icon);

    lib.drag.element(subtask_div, async () => {
      await updateSubtaskOrder(container);
    }, move_icon, "v");

    lib.drag.drop(subtask_div, null, "drag-over", "v");

    description_input.addEventListener("blur", async () => {
      if (description_input.value === description_input.dataset.initial_value) {
        return;
      }

      if (!description_input.value.trim()) {
        description_input.value = description_input.dataset.initial_value;
        return lib.message("A subtarefa não pode ser vazia.");
      }

      let response = await API.response(Subtask.update, {
        id: subtask.id,
        description: description_input.value.trim()
      });

      if (!response) { return; }
      description_input.dataset.initial_value = description_input.value;
    });

    done_icon.addEventListener("click", async () => {
      let new_status = subtask.status === "Concluído" ? "Pendente" : "Concluído";

      let response = await API.response(Subtask.update, {
        id: subtask.id,
        status: new_status
      });

      if (!response) { return; }

      subtask.status = new_status;

      if (new_status === "Concluído") {
        description_input.classList.add("line-through", "opacity-out-06");
        done_icon.classList.add("opacity-out-04");
      } else {
        description_input.classList.remove("line-through", "opacity-out-06");
        done_icon.classList.remove("opacity-out-04");
      }

      renderSubtaskDeadline(subtask, deadline_icon);
    });

    delete_icon.addEventListener("click", async () => {
      lib.confirm("Deseja excluir a subtarefa?", async r => {
        if (r) { return; }

        let response = await API.response(Subtask.delete, subtask.id);
        lib.message(response, async () => {
          subtask_div.remove();
          await updateSubtaskOrder(container);
        });
      }, "Não excluir", "Excluir subtarefa");
    });

    return subtask_div;
  }

  function subtaskCalendarSlot(subtask_id) {
    if (typeof calendarLoadSchedule !== "function") { return null; }

    const schedule = calendarLoadSchedule();
    const id = calendarNormalizeId(subtask_id);

    for (const date_key of Object.keys(schedule)) {
      const day_slots = schedule[date_key] || {};

      for (const time of Object.keys(day_slots)) {
        const items = calendarNormalizeSlot(day_slots[time]);
        if (items.subtasks.includes(id)) {
          return { date_key, time };
        }
      }
    }

    return null;
  }

  function renderSubtaskDeadline(subtask, deadline_icon) {
    const slot = subtaskCalendarSlot(subtask.id);
    const repeat = typeof calendarGetRepeat === "function" && calendarGetRepeat("subtask", subtask.id);
    const has_schedule = Boolean(slot || subtask.due_date || repeat);

    deadline_icon.classList.toggle("opacity-05", !has_schedule);
    deadline_icon.classList.toggle("opacity-10", has_schedule);
  }

  function openSubtaskDeadline(subtask, deadline_icon) {
    if (typeof calendarOpenItemSchedule !== "function") {
      return lib.message("O calendário ainda não está disponível.");
    }

    calendarOpenItemSchedule({
      kind: "subtask",
      id: subtask.id,
      canClear: Boolean(subtask.due_date),
      persist: async (date_key, time) => {
        const due_date = date_key && time
          ? lib.datetimeToTimestamp(`${date_key}T${time}`)
          : null;

        if (date_key && time && !due_date) {
          lib.message("O horário é inválido.");
          return false;
        }

        const response = await API.response(Subtask.update, {
          id: subtask.id,
          due_date
        });
        if (!response) { return false; }

        subtask.due_date = due_date;
        return true;
      },
      onDone: () => renderSubtaskDeadline(subtask, deadline_icon)
    });
  }
</script>